# AppArmor profile for cronie's crond. The jobs it runs (anacron among
# them) are not confined by it.

abi <abi/4.0>,

include <tunables/global>

profile cronie /usr/sbin/crond flags=(attach_disconnected) {
  include <abstractions/base>
  include <abstractions/nameservice>

  # Signals from root's shells and what they run (kill, rc-service, ...),
  # which Alpine's busybox profile, in unconfined mode, labels busybox
  signal (receive) peer=busybox,

  capability setgid,
  capability setuid,

  /usr/sbin/crond mr,
  /etc/crontab r,
  /etc/cron.d/{,*} r,
  /etc/crontabs/{,*} r,
  /etc/cron.{allow,deny} r,
  /var/spool/cron/{,**} r,
  /etc/zoneinfo/** r,
  @{run}/crond.pid rwk,
  @{run}/cron.reboot rw,
  @{PROC}/@{pid}/fd/ r,

  # Jobs run through /bin/sh, and mail their output with sendmail.
  /bin/busybox Ux,
  /bin/bash Ux,
  /usr/sbin/sendmail Ux,

  include if exists <local/cronie>
}
