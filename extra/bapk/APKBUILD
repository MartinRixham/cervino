# Bold APK (bapk), a terminal interface for apk, which Alpine doesn't
# package. Published to the update repo but not in world, so installs add
# it with apk. A change here needs a new pkgrel, as ci/publish-repo.sh keeps
# a file already published.
pkgname=bapk
pkgver=0.1.0
pkgrel=0
pkgdesc="Terminal user interface for the apk package manager"
url="https://github.com/martinrixham/bold-apk"
arch="all"
license="GPL-3.0-only"
makedepends="cargo cargo-auditable"
source="$pkgname-$pkgver.tar.gz::https://github.com/martinrixham/bold-apk/archive/refs/tags/v$pkgver.tar.gz"
builddir="$srcdir/bold-apk-$pkgver"
# cargo fetches the crates in prepare().
options="net"

prepare() {
	default_prepare
	cargo fetch --target="$CTARGET" --locked
}

build() {
	cargo auditable build --release --frozen
}

check() {
	cargo test --frozen
}

package() {
	install -Dm755 target/release/bapk -t "$pkgdir"/usr/bin
}

sha512sums="
76c20cbf46271327598232edd97aebfca71d1d072f5370b766dde754f6ac485455b30f6a08d30482174d8a3e51e932c859d2d131ad196d186e5838d58f4e7e18  bapk-0.1.0.tar.gz
"
