3550fea6e3cc1fd010c5280162d9b98e712d9d919d2e7bbd634f95e87501391949ac148cb5000b21acca2daaaf4bae0f40b6c20a44cc3e97e2f08f0ba7dc6f95  soloist-musl.patch
2d0b786032f7173f1dc1e02df29397b4958b524948ff0d6e0d3985f898c5534c8c5d60b857478e4d45fd094c0cf484a6ac81601f7e8426886cba92324d8917b0  soloist-musl.c
