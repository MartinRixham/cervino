# GNOME Notes (Bijiben), which Alpine doesn't package, built from the
# 41.0 release of a fork of it: GNOME's last release, 40.2, is GTK 3, so it
# ignores GNOME's dark style, and the fork releases the GTK 4 and
# libadwaita port. gitlab.gnome.org turns down programs' downloads of a
# personal project's archives (HTTP 406), so unpack() clones the tag and
# checks that it is _commit, which stands in for the checksum. Published
# to the update repo but not in world, so installs add it with apk. A
# change here needs a new pkgrel, as ci/publish-repo.sh keeps a file
# already published.
pkgname=bijiben
pkgver=41.0
_commit=bae040ec9ff589b510bda2e0461fbc519689573f
pkgrel=0
pkgdesc="Note editor for GNOME"
url="https://gitlab.gnome.org/MartinRixham/gnome-notes"
arch="all"
license="GPL-3.0-or-later"
makedepends="
	curl-dev
	desktop-file-utils
	evolution-data-server-dev
	git
	glib-dev
	gnome-online-accounts-dev
	gtk4.0-dev
	itstool
	json-glib-dev
	libadwaita-dev
	libxml2-dev
	meson
	tinysparql-dev
	util-linux-dev
	webkit2gtk-6.0-dev
	"
checkdepends="dbus"
subpackages="$pkgname-doc $pkgname-lang"
_tag=BIJIBEN_${pkgver//./_}
builddir="$srcdir/gnome-notes"

unpack() {
	mkdir -p "$srcdir"
	git -c advice.detachedHead=false clone --quiet --depth 1 --branch "$_tag" \
		"$url.git" "$builddir"
	[ "$(git -C "$builddir" rev-parse HEAD)" = "$_commit" ] ||
		die "$_tag is not $_commit"
}

build() {
	abuild-meson \
		-Dupdate_mimedb=false \
		. output
	meson compile -C output
}

check() {
	meson test --print-errorlogs -C output
}

package() {
	DESTDIR="$pkgdir" meson install --no-rebuild -C output
}

