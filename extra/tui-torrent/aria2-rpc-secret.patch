tui-torrent starts aria2c with its RPC interface listening on every
interface, allowing every origin and with no secret, so anyone on the
network, or any web page in the user's browser, could add downloads and
set their options (where aria2c writes a file among them). Start it on
loopback only (aria2c's default), with a random secret each run, given
to aria2c in a configuration file only the user can read (its command
line is everyone's), and send the secret with every call.

--- a/src/aria2_client.rs
+++ b/src/aria2_client.rs
@@ -1,6 +1,26 @@
 use serde::Deserialize;
 use serde_json::json;
+use std::io::Read;
+use std::sync::OnceLock;
 
+/// The RPC secret of the aria2c this process starts: random, so that no
+/// other program or web page can drive it.
+pub fn rpc_secret() -> &'static str {
+    static SECRET: OnceLock<String> = OnceLock::new();
+    SECRET.get_or_init(|| {
+        let mut bytes = [0u8; 16];
+        std::fs::File::open("/dev/urandom")
+            .and_then(|mut f| f.read_exact(&mut bytes))
+            .expect("could not read /dev/urandom");
+        bytes.iter().map(|b| format!("{:02x}", b)).collect()
+    })
+}
+
+/// The first parameter of every RPC call, which aria2 checks the secret by.
+pub fn token() -> String {
+    format!("token:{}", rpc_secret())
+}
