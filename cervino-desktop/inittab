# /etc/inittab

::sysinit:/sbin/openrc sysinit
::sysinit:/sbin/openrc boot
# A new version of an atomic install on a Pi, not tried at the restart
# (switched off instead): restarts to try it, before the desktop starts.
::sysinit:/usr/libexec/cervino/boot-trial retry
::wait:/sbin/openrc default
# A new version of an atomic install, on trial, has started.
::once:/usr/libexec/cervino/boot-trial boot

# Set up a couple of getty's
tty1::respawn:/usr/libexec/cervino/apparmor-exec busybox-getty /sbin/getty 38400 tty1
tty2::respawn:/usr/libexec/cervino/apparmor-exec busybox-getty /sbin/getty 38400 tty2
tty3::respawn:/usr/libexec/cervino/apparmor-exec busybox-getty /sbin/getty 38400 tty3
tty4::respawn:/usr/libexec/cervino/apparmor-exec busybox-getty /sbin/getty 38400 tty4
tty5::respawn:/usr/libexec/cervino/apparmor-exec busybox-getty /sbin/getty 38400 tty5
tty6::respawn:/usr/libexec/cervino/apparmor-exec busybox-getty /sbin/getty 38400 tty6

# Put a getty on the serial port
#ttyS0::respawn:/usr/libexec/cervino/apparmor-exec busybox-getty /sbin/getty -L 115200 ttyS0 vt100

# Stuff to do for the 3-finger salute
::ctrlaltdel:/usr/sbin/reboot

# Stuff to do before rebooting
::shutdown:/sbin/openrc shutdown
::shutdown:/usr/libexec/cervino/boot-trial reboot
