#!/bin/sh
# Adds the desktop features' services to their runlevels, as the live image's
# are. Only on install: an upgrade leaves a service the user took out alone.
# (rc-update add does nothing for a service already in the runlevel.) The
# packages with their init scripts are dependencies, so they are installed
# first.

rc-update -q add apparmor sysinit
# Switches an atomic install to an update staged for the next start (does
# nothing elsewhere).
rc-update -q add cervino-atomic shutdown
rc-update -q add zram-init boot
for svc in networkmanager chronyd earlyoom openrc-settingsd bluetooth cupsd \
	avahi-daemon nftables apk-polkit-server wifi-region local; do
	rc-update -q add "$svc" default
done

exit 0
