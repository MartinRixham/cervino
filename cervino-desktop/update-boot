#!/bin/sh
# update-boot [ROOT]: brings the boot partition in step with the complete
# versions of the system on ROOT's volume (ROOT defaults to /): puts each
# one's kernel, initramfs, CPU microcode and command line on it, removes
# those of versions that are gone, and chooses the version that starts.
# That is the version on ROOT, which has started, and a newer one, if there
# is one that did not fail to start before, is started once on trial (see
# /usr/libexec/cervino/boot-trial).
#
# README.md (Installing to disk, Raspberry Pi) describes the boot
# partitions on a PC and on a Pi. On a Pi, autoboot.txt's tryboot_a_b has
# the firmware start from the other of partitions A and B (2 and 3) at a
# restart with the tryboot flag, and each one's config.txt starts its
# version through os_prefix. The partition that starts is never rewritten
# but for cmdline.txt and usercfg.txt when they change: a version goes to
# the other one, formatted anew.
#
# Does nothing but on an atomic install.

set -eu
# shellcheck source=atomic.sh
. /usr/libexec/cervino/atomic.sh

root=${1:-/}
root=${root%/}
atomic_detect "$root" || exit 0

pi= esp=$root/boot/efi
if atomic_pi "$root"; then
	pi=1 esp=$root/boot/firmware
elif [ ! -d /sys/firmware/efi ]; then
	echo "update-boot: an atomic install starts only with UEFI," \
		"and this PC started without it" >&2
	exit 1
fi

if ! mountpoint -q "$esp"; then
	[ -z "$root" ] && mount "${esp#"$root"}" ||
		{ echo "update-boot: the boot partition is not mounted on $esp" >&2; exit 1; }
fi

if [ -n "$pi" ] && [ ! -f "$esp"/autoboot.txt ]; then
	echo "update-boot: there is no autoboot.txt on $esp" >&2
	exit 1
fi

atomic_mount
# ukify's temporary files: at shutdown /tmp and /var are unmounted and / is
# read-only, so in /run.
TMPDIR=$(mktemp -d /run/cervino-boot.XXXXXX)
export TMPDIR
cleanup() {
	umount "$top".p2 "$top".p3 2>/dev/null || :
	rmdir "$top".p2 "$top".p3 2>/dev/null || :
	atomic_umount
	rm -rf "$top".cmdline "$TMPDIR"
}
trap cleanup EXIT
atomic_staged

# copy FROM TO: replaces TO with FROM unless they are the same already. The
# copy is renamed into place, so TO is never half written.
copy() {
	cmp -s "$1" "$2" && return 0
	mkdir -p "${2%/*}"
	cp "$1" "$2".new
	mv "$2".new "$2"
}

# replace NEW FILE: renames NEW to FILE, unless they are the same.
replace() {
	if cmp -s "$1" "$2"; then rm -f "$1"; else mv "$1" "$2"; fi
}

made() {
	echo "$1" | sed -n 's/^\(....\)\(..\)\(..\)\(..\)\(..\).*/\1-\2-\3 \4:\5 UTC/p'
}

# pick_kernel ID: sets kernel to the kernel version ID starts with, empty if
# it has none: on a Pi as Alpine's config.txt would pick it, a variant
# (vmlinuz-rpi16k) over vmlinuz-rpi; on a PC lts over the others.
pick_kernel() {
	local k src="$top/roots/$1/boot"
	kernel=
	if [ -n "$pi" ]; then
		set -- "$src"/vmlinuz-rpi "$src"/vmlinuz-rpi*
	else
		set -- "$src"/vmlinuz-* "$src"/vmlinuz-lts
	fi
	for k; do
		[ -f "$k" ] && [ -f "$src/initramfs-${k##*/vmlinuz-}" ] && kernel=${k##*/}
	done
	return 0
}

# cmdline ID: version ID's kernel command line: its /etc/kernel/cmdline and
# the subvolume to mount.
cmdline() {
	echo "$(cat "$top/roots/$1"/etc/kernel/cmdline) rootflags=subvol=/roots/$1"
}

# config FILE ID: writes the Pi's config.txt that starts version ID to FILE.
config() {
	pick_kernel "$2"
	{
		echo "# Written by /usr/libexec/cervino/update-boot, which replaces any changes:"
		echo "# put your own settings in usercfg.txt."
		echo "# This version of the system, made $(made "$2"):"
		echo "os_prefix=cervino/$2/"
		echo "kernel=$kernel"
		echo "initramfs initramfs-${kernel#vmlinuz-}"
		echo "arm_64bit=1"
		echo "include usercfg.txt"
	} > "$1"
}

# Each complete version's boot files, newest first. They never change, but
# for the command line, so they are made once. On a Pi, the boot partitions
# get the versions they hold below.
keep=
for id in $(ls -r "$top"/roots); do
	atomic_ready "$id" && [ -f "$top/roots/$id"/etc/kernel/cmdline ] || continue
	pick_kernel "$id"
	[ -n "$kernel" ] || continue
	keep="$keep $id"
	[ -z "$pi" ] || continue
	src=$top/roots/$id/boot dst=$esp/cervino/$id
	cmdline "$id" > "$top".cmdline
	if [ ! -f "$dst"/linux.efi ] || ! cmp -s "$top".cmdline "$dst"/cmdline; then
		# The microcode goes first, uncompressed, as the kernel looks for it
		# at the start of the initramfs.
		set --
		for ucode in amd-ucode.img intel-ucode.img; do
			[ ! -f "$src/$ucode" ] || set -- "$@" --initrd="$src/$ucode"
		done
		mkdir -p "$dst"
		ukify build --linux="$src/$kernel" "$@" \
			--initrd="$src/initramfs-${kernel#vmlinuz-}" \
			--cmdline=@"$top".cmdline \
			--os-release=@"$top/roots/$id"/usr/lib/os-release \
			--output="$dst"/linux.efi.new >/dev/null
		sync
		mv "$dst"/linux.efi.new "$dst"/linux.efi
		copy "$top".cmdline "$dst"/cmdline
	fi
done
rm -f "$top".cmdline
[ -n "$keep" ] || { echo "update-boot: no kernel to boot on $atomic_dev" >&2; exit 1; }

# Which version starts, and which one is on trial. Failed versions that are
# gone are forgotten.
if [ -f "$top"/boot-failed ]; then
	ls "$top"/roots | grep -Fx -f "$top"/boot-failed > "$top"/boot-failed.new || :
	if [ -s "$top"/boot-failed.new ]; then
		mv "$top"/boot-failed.new "$top"/boot-failed
	else
		rm -f "$top"/boot-failed.new "$top"/boot-failed
	fi
fi

# shellcheck disable=SC2086
set -- $keep
start=$1 try=
case " $keep " in *" $atomic_id "*)
	if atomic_trial "$root"; then
		start=$atomic_id
		for id in $keep; do
			[ "$id" -gt "$start" ] || break
			atomic_failed "$id" || { try=$id; break; }
		done
	fi
esac

if [ -n "$pi" ]; then
	# The disk and its partition N's device, which partdev prints.
	part=$(awk -v m="$esp" '$2 == m { print $1 }' /proc/mounts)
	disk=$(basename "$(readlink -f /sys/class/block/"$(basename "$(readlink -f "$part")")"/..)")
	partdev() {
		local p
		for p in /sys/class/block/"$disk"/*/partition; do
			[ "$(cat "$p")" = "$1" ] || continue
			echo /dev/"$(basename "${p%/partition}")"
			return 0
		done
		echo "update-boot: $disk has no partition $1" >&2
		return 1
	}

	# held N: the version partition N starts (its config.txt's), if any.
	held() {
		sed -n 's|^os_prefix=cervino/\([0-9]*\)/$|\1|p' "$top.p$1"/config.txt 2>/dev/null ||
			:
	}

	# wipe N: formats partition N anew, mounted on $top.pN.
	wipe() {
		local dev
		dev=$(partdev "$1")
		umount "$top.p$1" 2>/dev/null || :
		mkfs.vfat -F 32 -n "BOOT_$(echo "$1" | tr 23 AB)" "$dev" >/dev/null
		mount -t vfat "$dev" "$top.p$1"
	}

	# fill N ID: makes partition N start version ID: formatted anew (so
	# nothing of what was there, or of a write to it cut short, is left),
	# with the firmware and ID's files, and config.txt last.
	fill() {
		local src="$top/roots/$2/boot" dst="$top.p$1/cervino/$2" f
		echo "Copying the version of $(made "$2") to boot partition $1"
		wipe "$1"
		for f in "$src"/bootcode.bin "$src"/start*.elf "$src"/fixup*.dat; do
			[ ! -f "$f" ] || cp "$f" "$top.p$1"/
		done
		pick_kernel "$2"
		mkdir -p "$dst"
		cp "$src/$kernel" "$src/initramfs-${kernel#vmlinuz-}" "$src"/*.dtb "$dst"/
		cp -r "$src"/overlays "$dst"/
		# The firmware loads overlays from os_prefix's overlays/ only if it
		# has a README, and Alpine's kernel package ships none.
		echo "Device tree overlays for this version of the system." > "$dst"/overlays/README
		cmdline "$2" > "$dst"/cmdline.txt
		[ ! -f "$esp"/usercfg.txt ] || cp "$esp"/usercfg.txt "$top.p$1"/
		sync
		config "$top.p$1"/config.txt "$2"
		sync
	}

	for n in 2 3; do
		mkdir -p "$top.p$n"
		mount -t vfat "$(partdev $n)" "$top.p$n" 2>/dev/null || :
	done
	def=$(sed -n '/^\[all\]/,/^\[/s/^boot_partition=\([23]\)$/\1/p' "$esp"/autoboot.txt)
	[ "$def" = 3 ] || def=2
	alt=$((5 - def))

	# The version that starts: in the partition that starts already, or
	# in the other one, which is made the one that starts, put there first
	# if need be. Only an empty partition that starts (a new install's) is
	# written.
	if [ "$(held "$def")" != "$start" ]; then
		if [ -z "$(held "$def")" ]; then
			fill "$def" "$start"
		else
			[ "$(held "$alt")" = "$start" ] || fill "$alt" "$start"
			def=$alt alt=$((5 - alt))
		fi
	fi

	# The one on trial in the other partition. Else that keeps the version
	# that was there (the one that started before, to start by hand), unless
	# it was deleted.
	if [ -n "$try" ]; then
		[ "$(held "$alt")" = "$try" ] || fill "$alt" "$try"
	elif [ -n "$(held "$alt")" ]; then
		case " $keep " in *" $(held "$alt") "*) ;; *) wipe "$alt" ;; esac
	fi

	# Changed command lines and usercfg.txt, small files rewritten in place.
	for n in 2 3; do
		id=$(held $n)
		[ -n "$id" ] || continue
		case " $keep " in *" $id "*) ;; *) continue ;; esac
		cmdline "$id" > "$top".cmdline
		copy "$top".cmdline "$top.p$n/cervino/$id"/cmdline.txt
		[ ! -f "$esp"/usercfg.txt ] || copy "$esp"/usercfg.txt "$top.p$n"/usercfg.txt
	done

	{
		echo "# Written by /usr/libexec/cervino/update-boot, which replaces any changes."
		echo "# The firmware starts the system from boot partition $def, or, at a"
		echo "# restart to try a new version, from $alt. To start the version in $alt"
		echo "# instead (on another computer if this one does not start), swap them."
		echo "[all]"
		echo "tryboot_a_b=1"
		echo "boot_partition=$def"
		echo "[tryboot]"
		echo "boot_partition=$alt"
	} > "$esp"/autoboot.txt.new
	sync
	replace "$esp"/autoboot.txt.new "$esp"/autoboot.txt
else
	copy "$esp/cervino/$start"/linux.efi "$esp"/EFI/BOOT/BOOTX64.EFI
	sync

	# The boot entries, "Alpine Linux" and the date and time the version was
	# made, on this partition (other disks' are left alone). entries prints
	# each one's number and version, or "-" for the one that started Limine,
	# which atomic installs used before.
	part=$(awk -v m="$esp" '$2 == m { print $1 }' /proc/mounts)
	part=$(basename "$(readlink -f "$part")")
	disk=/dev/$(basename "$(readlink -f /sys/class/block/"$part"/..)")
	partuuid=$(blkid -s PARTUUID -o value /dev/"$part" | tr 'A-F' 'a-f')
	[ -n "$partuuid" ] || { echo "update-boot: no PARTUUID for /dev/$part" >&2; exit 1; }

	entries() {
		efibootmgr -v | awk -v uuid="$partuuid" '
			/^Boot[0-9A-Fa-f][0-9A-Fa-f][0-9A-Fa-f][0-9A-Fa-f]/ && index(tolower($0), uuid) {
				label = $0
				sub(/^Boot[0-9A-Fa-f]+\*? /, "", label)
				sub(/\t.*/, "", label)
				if (label ~ /^Alpine Linux [0-9]+-[0-9]+-[0-9]+ [0-9]+:[0-9]+:[0-9]+$/) {
					gsub(/[^0-9]/, "", label)
					print substr($1, 5, 4), label
				} else if (label == "Alpine Linux")
					print substr($1, 5, 4), "-"
			}'
	}

	efi() {
		efibootmgr -q "$@" >/dev/null ||
			{ echo "update-boot: efibootmgr $* failed" >&2; exit 1; }
	}

	ents=$(entries)
	for n in $(echo "$ents" |
		awk -v keep=" $keep " 'NF && !index(keep, " " $2 " ") { print $1 }'); do
		efi -b "$n" -B
	done

	for id in $keep; do
		echo "$ents" | grep -q " $id$" && continue
		efi --create --disk "$disk" --part "$(cat /sys/class/block/"$part"/partition)" \
			--loader "\\cervino\\$id\\linux.efi" \
			--label "Alpine Linux $(echo "$id" |
				sed 's/^\(....\)\(..\)\(..\)\(..\)\(..\)\(..\)$/\1-\2-\3 \4:\5:\6/')"
	done

	ents=$(entries)
	num() {
		echo "$ents" | awk -v id="$1" '$2 == id { print $1; exit }'
	}

	# BootOrder: the version that starts, the others, newest first, then
	# whatever else was there.
	order=$(num "$start")
	for id in $keep; do
		[ "$id" = "$start" ] || order="$order,$(num "$id")"
	done
	for n in $(efibootmgr | sed -n 's/^BootOrder: //p' | tr , ' '); do
		echo "$ents" | grep -qi "^$n " || order="$order,$n"
	done
	efi -o "$order"

	next=$(efibootmgr | sed -n 's/^BootNext: //p')
	if [ -n "$try" ]; then
		efi -n "$(num "$try")"
	elif [ -n "$next" ] && echo "$ents" | grep -qi "^$next "; then
		efi -N
	fi

	# Limine's files and the kernels it started, from before.
	rm -rf "$esp"/limine
	for dir in "$esp"/cervino/*; do
		rm -f "$dir"/vmlinuz-* "$dir"/initramfs-* "$dir"/*-ucode.img
	done
fi

# For the next start: the version on trial, on the volume to tell whether it
# started, and in /run for update-alpine list and the shutdown.
if [ -z "$root" ]; then
	if [ -n "$try" ]; then
		echo "$try" > "$top"/boot-trying
		echo "$try" > /run/cervino-trial
	else
		rm -f "$top"/boot-trying /run/cervino-trial
	fi
fi

for dir in "$esp"/cervino/*; do
	case " $keep " in *" ${dir##*/} "*) ;; *) rm -rf "$dir" ;; esac
done
sync
