#!/bin/sh
# Arguments: the new version, the old one.
# Gives users who have none subordinate IDs, for rootless containers (see
# /usr/libexec/cervino/subids): installs made before this package did
# so have users without them.

/usr/libexec/cervino/subids || :

# Encrypted atomic installs made before the initramfs asked for the disk's
# passphrase with disk-passphrase (which keeps it for an automatic login to
# unlock the login keyring with) get it as new ones do (see
# live/setup-disk): once, from an older version, so that a user who takes
# it out keeps it out, and not where the command line has a cryptkey of
# its own. update-alpine runs this in its chroot of the new version, whose
# initramfs is built again here; update-boot puts it on the boot partition
# with the new command line once the version is complete.
migrate_passphrase() {
	local cmdline conf=/etc/mkinitfs/mkinitfs.conf k
	[ -f /etc/kernel/cmdline ] || return 0
	[ "$(/sbin/apk version -t "$1" 20261115.163432)" != ">" ] || return 0
	cmdline=" $(cat /etc/kernel/cmdline) "
	case $cmdline in *" cryptroot="*) ;; *) return 0 ;; esac
	case $cmdline in *" cryptkey="*) return 0 ;; esac

	# The initramfs first: the command line names a program it must have.
	grep -q '^features=.*[" ]cervino-passphrase[" ]' "$conf" ||
		sed -i 's|^features="\(.*\)"|features="\1 cervino-passphrase"|' "$conf" ||
		return 1
	for k in /lib/modules/*; do
		k=${k##*/}
		[ -e /boot/vmlinuz-"${k##*-}" ] || continue
		mkinitfs -o /boot/initramfs-"${k##*-}" "$k" || return 1
	done
	sed -i '1s|$| cryptkey=EXEC=/usr/libexec/cervino/disk-passphrase|' /etc/kernel/cmdline ||
		return 1
	/usr/libexec/cervino/update-boot
}
[ -z "$2" ] || migrate_passphrase "$2" ||
	echo "cervino-desktop: could not have the initramfs keep the disk's passphrase" >&2

exit 0
