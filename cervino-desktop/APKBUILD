# The desktop features' configuration, as a package: the live image installs
# it from its on-disc repo, and so does setup-disk on systems installed from
# it, so a newer package can bring configuration changes to those systems.
# build-alpine-gnome-iso.sh copies this directory into the build, with
# cervino-desktop.conf (PKGVER, the version; DEPENDS, the packages of the
# desktop features; PUBKEY, the file name of the public key it is signed with,
# which is copied next to it; REPO, the URL of the repo it is published in,
# or empty; TARGET_ARCH, the architecture it is for), flathub.flatpakrepo and
# the repo's AppArmor profiles (apparmor.d/) next to it.
#
# Some of the files belong to other packages (alpine-baselayout's inittab and
# root crontab, shadow's login.defs, the daemons' conf.d files): replaces=
# lets this package take them over, and keeps them when those packages are
# upgraded or reinstalled. As with any package, a file in /etc changed since
# it was installed is left as it is, and the new version written next to it
# as .apk-new.
. "$startdir"/cervino-desktop.conf

pkgname=cervino-desktop
pkgver=$PKGVER
pkgrel=0
pkgdesc="Configuration of the Cervino GNOME desktop"
url="https://github.com/MartinRixham/cervino"
arch="noarch"
license="Apache-2.0"
# gjs runs the gnome-shell-compat helper; the "Update Alpine Linux" launcher
# runs update-alpine with doas in GNOME Console; the post-install script
# enables the services of the -openrc packages.
depends="/bin/sh doas gjs gnome-console apk-polkit-rs-openrc apparmor-openrc avahi-openrc bluez-openrc
	chrony-openrc cups-openrc earlyoom-openrc networkmanager-openrc
	nftables-openrc openrc openrc-settingsd-openrc spice-vdagent-openrc
	zram-init-openrc $DEPENDS"
replaces="alpine-baselayout alpine-baselayout-data busybox-openrc dbus-openrc
	earlyoom-openrc openrc shadow zram-init-openrc"
install="$pkgname.post-install"
triggers="$pkgname.trigger=/etc/apparmor.d:/etc/apparmor.d/*:/boot"
# abuild would make the package provide a cmd: for each of its commands,
# and cmd:apk, for the apk wrapper, conflicts with apk-tools' own; so no
# tracing, and the /bin/sh the install scripts need is listed by hand.
# The Pi's package has one program, tryboot, built for aarch64: abuild
# would refuse that in a noarch package, but the build makes one package per
# architecture anyway (its dependencies differ), indexed as that one's.
options="!check !tracedeps !archcheck"

build() {
	[ "$TARGET_ARCH" = aarch64 ] || return 0
	clang --target=aarch64-linux-musl -O2 -Wall -Wextra -Werror -ffreestanding \
		-fno-stack-protector -nostdlib -static -fuse-ld=lld -Wl,--build-id=none -s \
		-o "$srcdir"/tryboot "$startdir"/tryboot.c
}

makefile() {
	mkdir -p "$(dirname "$3")"
	cat > "$3"
	chown "$1" "$3"
	chmod "$2" "$3"
}

package() {
	# The key this package and its repo are signed with, so that a newer
	# package can bring a new one, and the repo installs get newer ones from,
	# where it is published. apk 3 reads repositories.d/*.list as well as
	# /etc/apk/repositories, which stays the user's.
	makefile root:root 0644 "$pkgdir"/etc/apk/keys/"$PUBKEY" < "$startdir"/"$PUBKEY"
	if [ -n "$REPO" ]; then
		echo "$REPO" | makefile root:root 0644 "$pkgdir"/etc/apk/repositories.d/cervino.list
	fi

	# Login shells: nano as the default editor, ~/.local/bin first in PATH
	# (any existing entry removed, so nested login shells don't add it twice).
	makefile root:root 0644 "$pkgdir"/etc/profile.d/50-editor.sh <<'EOF'
export EDITOR="${EDITOR:-nano}"
EOF
	makefile root:root 0644 "$pkgdir"/etc/profile.d/99-local-bin.sh <<'EOF'
_p=":$PATH:"
while case $_p in *":$HOME/.local/bin:"*) true ;; *) false ;; esac; do
	_p="${_p%%:"$HOME"/.local/bin:*}:${_p#*:"$HOME"/.local/bin:}"
done
_p="${_p#:}"
_p="${_p%:}"
PATH="$HOME/.local/bin${_p:+:$_p}"
export PATH
unset _p
EOF
	# command-not-found only installs a hook for login sh; bash sources /etc/bash/*.sh.
	mkdir -p "$pkgdir"/etc/bash
	ln -s /etc/profile.d/command-not-found.sh "$pkgdir"/etc/bash/command-not-found.sh

	# Session language when the user has not picked one.
	makefile root:root 0644 "$pkgdir"/etc/locale.conf <<'EOF'
LANG=C.UTF-8
EOF

	# New users get bash as their login shell: shadow's useradd (used by
	# GNOME Settings) reads this; setup-user's busybox adduser, run in the
	# live system's installer, goes through the live image's adduser shim.
	makefile root:root 0644 "$pkgdir"/etc/default/useradd <<'EOF'
SHELL=/bin/bash
EOF
	# Only the owner (and root) can read a new user's home directory: useradd
	# creates it with HOME_MODE (the rest is Alpine's login.defs); the live
	# image's adduser shim does the same for busybox adduser, which has no
	# such setting.
	makefile root:root 0644 "$pkgdir"/etc/login.defs <<'EOF'
USERGROUPS_ENAB yes
UID_MIN 1000
HOME_MODE 0700
EOF

	# NetworkManager manages all interfaces; ifupdown only brings up lo.
	# With several name servers in resolv.conf, musl asks them all at once and
	# takes the first answer, NXDOMAIN included, so a VPN's internal names
	# resolve only when its server happens to answer first (and musl ignores
	# servers after the third). NetworkManager's dnsmasq, the only server in
	# resolv.conf, sends each connection's DNS domains to that connection's
	# servers instead.
	# Wi-Fi power saving on Broadcom's SDIO chips (brcmfmac: the Raspberry
	# Pi's, and some x86 boards') adds hundreds of milliseconds of latency and
	# drops connections, so it is turned off for them alone.
	makefile root:root 0644 "$pkgdir"/etc/NetworkManager/conf.d/10-alpine.conf <<'EOF'
[main]
dhcp=internal
plugins=keyfile
dns=dnsmasq

[connection-brcmfmac]
match-device=driver:brcmfmac
wifi.powersave=2
EOF
	makefile root:root 0644 "$pkgdir"/etc/network/interfaces <<'EOF'
auto lo
iface lo inet loopback
iface lo inet6 loopback
EOF

	# The default nftables ruleset drops incoming connections; allow SSH,
	# mDNS and AirPlay: a speaker sends PipeWire's AirPlay sink timing and
	# control packets on UDP 6001 and up (6001/6002 for the first sink) before
	# PipeWire has sent anything there, so conntrack can't take them for
	# replies. It also drops all forwarded traffic, which would cut containers
	# (Docker, Podman, LXC/Incus) and VMs (libvirt) on their NAT bridges off
	# the network whatever rules they add in their own tables: let traffic from
	# their bridges out and the replies back in. Drop IPv6 packets from source
	# addresses the host has no route back to, as spoofed, before any input or
	# forward rule sees them; Neighbor Discovery is exempt (DAD's solicits come
	# from ::). IPv4 has the kernel's rp_filter.
	makefile root:root 0644 "$pkgdir"/etc/nftables.d/50-desktop.nft <<'EOF'
table inet filter {
	chain rpfilter {
		type filter hook prerouting priority filter + 10; policy accept;
		icmpv6 type { nd-router-advert, nd-neighbor-solicit } accept
		meta nfproto ipv6 fib saddr . mark oif missing drop comment "IPv6 reverse path filter"
	}
	chain input {
		tcp dport 22 accept comment "SSH"
		udp dport 5353 accept comment "mDNS"
		udp dport 6001-6010 accept comment "AirPlay (PipeWire RAOP) timing and control"
	}
	chain forward {
		ct state { established, related } accept comment "Replies"
		ct state invalid drop comment "Drop invalid connections"
		iifname "virbr*" accept comment "libvirt"
		iifname "docker*" accept comment "Docker"
		iifname "br-*" accept comment "Docker networks"
		iifname "podman*" accept comment "Podman"
		iifname "cni-*" accept comment "CNI"
		iifname "lxcbr*" accept comment "LXC"
		iifname "lxdbr*" accept comment "LXD"
		iifname "incusbr*" accept comment "Incus"
	}
}
EOF

	# PipeWire adds a sink for each AirPlay speaker Avahi finds. Keep its stream
	# running while nothing plays: when a player pauses (VLC does while it
	# buffers), PipeWire would stop the stream and restart it on the same RTSP
	# session with a jump in the RTP timestamps, and AirPlay 2 speakers then drop
	# everything that follows in silence. For the same reason, keep it in the
	# Dummy-Driver's group, so it always runs on that clock: otherwise, while
	# another sink such as HDMI plays (a GNOME alert sound is enough), PipeWire
	# moves it onto that sink's clock and back, and its RTP timestamps jump.
	makefile root:root 0644 "$pkgdir"/etc/pipewire/pipewire.conf.d/50-raop.conf <<'EOF'
context.modules = [
	{ name = libpipewire-module-raop-discover
		condition = [ { module.raop = !false } ]
		args = {
			stream.rules = [
				{ matches = [ { raop.ip = "~.*" } ]
					actions = {
						create-stream = {
							stream.props = {
								node.pause-on-idle = false
								node.always-process = true
								node.group = pipewire.dummy
							}
						}
					}
				}
			]
		}
	}
]
EOF

	# Since those streams never stop, neither does their RTSP session, and a
	# speaker can drop it without telling PipeWire (a KEF LSX II did), which
	# then streams into it in silence for good. A WirePlumber hook suspends an
	# AirPlay sink when a stream starts playing to it after 30 s with none,
	# which gets it a new session; within those 30 s (a track change) it
	# keeps the old one.
	makefile root:root 0644 "$pkgdir"/etc/wireplumber/wireplumber.conf.d/50-raop-refresh.conf <<'EOF'
wireplumber.components = [
  {
    name = cervino/raop-refresh.lua, type = script/lua
    provides = custom.raop-refresh
  }
]

wireplumber.profiles = {
  main = {
    custom.raop-refresh = required
  }
}
EOF
	makefile root:root 0644 "$pkgdir"/usr/share/wireplumber/scripts/cervino/raop-refresh.lua \
		< "$startdir"/raop-refresh.lua

	# sshd (installed, not enabled) serves sftp with the external sftp-server,
	# which runs as the user outside sshd's AppArmor profile: Alpine's default,
	# internal-sftp, runs in sshd itself, whose profile would then have to let it
	# at every file. The first Subsystem line wins, and sshd_config includes
	# sshd_config.d before its own.
	makefile root:root 0644 "$pkgdir"/etc/ssh/sshd_config.d/50-sftp.conf <<'EOF'
Subsystem sftp /usr/lib/ssh/sftp-server
EOF

	# busybox syslogd rotates /var/log/messages itself, by default at 200 KiB
	# with one old file, which a busy desktop fills in minutes: keep 5 x 8 MiB.
	# It runs under its AppArmor profile (see AppArmor below).
	makefile root:root 0644 "$pkgdir"/etc/conf.d/syslog <<'EOF'
SYSLOGD_OPTS="-t -s 8192 -b 4"
apparmor_profile=busybox-syslogd
. /usr/libexec/cervino/apparmor-start.sh
EOF

	# The kernel sets the system clock from the hardware clock as it finds it,
	# and chrony keeps it right from then on, so hwclock need not set it again
	# (hwclock --systz, which the init script always runs, still corrects for a
	# hardware clock that keeps local time). Setting it waits for the clock's
	# update interrupt, which some VMs never raise: 10 s, then an error. The
	# file stays plain assignments: openrc-settingsd rewrites clock= in it.
	makefile root:root 0644 "$pkgdir"/etc/conf.d/hwclock <<'EOF'
clock="UTC"
clock_hctosys="NO"
EOF

	# SSDs need to be told which blocks are free; trim mounted file systems
	# weekly (anacron runs /etc/periodic, see below).
	makefile root:root 0755 "$pkgdir"/etc/periodic/weekly/fstrim <<'EOF'
#!/bin/sh
exec fstrim -a -q
EOF

	# zram swap of half the RAM, at most 8 GiB (the init script sources this).
	makefile root:root 0644 "$pkgdir"/etc/conf.d/zram-init <<'EOF'
load_on_start=yes
unload_on_stop=yes
num_devices=1
type0=swap
size0=$(awk '/^MemTotal:/ { s = int($2 / 2048); print (s > 8192 ? 8192 : s) }' /proc/meminfo)
algo0=zstd
labl0=zram_swap
EOF

	# When memory and swap run out the kernel thrashes, and the desktop can
	# freeze for minutes before its OOM killer acts. earlyoom kills the process
	# with the highest oom_score first, once available memory and free swap
	# (the zram above) are both below 10 % (SIGKILL below 5 %): browser
	# content processes before anything else. It never picks what the session
	# or logging in depends on (--ignore; --avoid would only lower their score),
	# since killing one of those ends every app at once. Names are as in
	# /proc/PID/comm, cut to 15 characters; the init script evals the regexes
	# inside single quotes.
	makefile root:root 0644 "$pkgdir"/etc/conf.d/earlyoom <<'EOF'
prefer_cmds="^(Web Content|Isolated Web Co|WebKitWebProces)$"
command_args="--ignore '^(gnome-shell|gnome-session-b|gnome-session-c|Xwayland|gdm|gdm-session-wor|gdm-wayland-ses|dbus-daemon|elogind-daemon|sshd|sshd-session)$'"
EOF

	# Core dumps go to /var/lib/coredump and are deleted after a week.
	makefile root:root 0644 "$pkgdir"/etc/sysctl.d/50-coredump.conf <<'EOF'
kernel.core_pattern = |/usr/libexec/cervino/coredump-handler %P %u %s %t
EOF
	makefile root:root 0755 "$pkgdir"/usr/libexec/cervino/coredump-handler <<'EOF'
#!/bin/sh
# Invoked by the kernel via core_pattern with: %P %u %s %t
pid=$1 uid=$2 sig=$3 time=$4
dir=/var/lib/coredump
max_files=20
max_bytes=2147483648

umask 077
mkdir -p "$dir"
comm=$(tr -cd 'A-Za-z0-9_.-' < "/proc/$pid/comm" 2>/dev/null)
out="$dir/core.${comm:-unknown}.$uid.$pid.$time"

if command -v zstd >/dev/null 2>&1; then
	out=$out.zst
	head -c "$max_bytes" | zstd -q -o "$out"
else
	head -c "$max_bytes" > "$out"
fi
logger -t coredump "Process $pid (${comm:-unknown}) of user $uid dumped core on signal $sig: $out"

ls -1t "$dir"/core.* 2>/dev/null | tail -n +$((max_files + 1)) | xargs -r rm -f
find "$dir" -name 'core.*' -mtime +7 -delete
EOF
	# Dumps also expire when no new crash comes along to prune them.
	makefile root:root 0755 "$pkgdir"/etc/periodic/daily/coredump-cleanup <<'EOF'
#!/bin/sh
[ -d /var/lib/coredump ] || exit 0
exec find /var/lib/coredump -name 'core.*' -mtime +7 -delete
EOF

	# Periodic jobs: cron (cronie, which the setup-alpine wrapper enables in
	# place of busybox crond) runs the daily, weekly and monthly ones at fixed
	# times, 02:00 to 05:00, when a laptop is usually off or asleep; busybox
	# crond never makes up a run it missed. So root's crontab keeps only the
	# 15min and hourly ones, and anacron (from cronie) runs the rest, once
	# per period, a few minutes after boot or within an hour of waking up if
	# they are due. /var/spool/anacron, where it keeps when each last ran, is
	# not in the package and not under /etc.
	makefile root:root 0600 "$pkgdir"/etc/crontabs/root <<'EOF'
# min	hour	day	month	weekday	command
*/15	*	*	*	*	run-parts /etc/periodic/15min
0	*	*	*	*	run-parts /etc/periodic/hourly
# daily, weekly and monthly: /etc/anacrontab
EOF
	makefile root:root 0644 "$pkgdir"/etc/cron.d/anacron <<'EOF'
@reboot	root	mkdir -p /var/spool/anacron && anacron -s
30 * * * *	root	mkdir -p /var/spool/anacron && anacron -s
EOF
	makefile root:root 0644 "$pkgdir"/etc/anacrontab <<'EOF'
SHELL=/bin/sh
PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
# There is no sendmail to mail job output to.
MAILTO=""
# period	delay (min)	job	command
1	5	periodic.daily	run-parts /etc/periodic/daily
7	10	periodic.weekly	run-parts /etc/periodic/weekly
@monthly	15	periodic.monthly	run-parts /etc/periodic/monthly
EOF

	# AppArmor: profiles (from the repo's apparmor.d) for system daemons;
	# Alpine's apparmor-profiles has Avahi's and dnsmasq's, which
	# apparmor.d/local adds to.
	# AppArmor loads them in sysinit, before udev starts, so that
	# udevd runs under its profile too.
	for f in "$startdir"/apparmor.d/* "$startdir"/apparmor.d/local/*; do
		[ -f "$f" ] || continue
		makefile root:root 0644 "$pkgdir"/etc/apparmor.d/"${f#"$startdir"/apparmor.d/}" < "$f"
	done
	makefile root:root 0644 "$pkgdir"/etc/conf.d/apparmor <<'EOF'
rc_need="sysfs"
rc_before="udev"
EOF
	# A profile attaches to a program by its path, which does not tell busybox
	# applets (syslogd, acpid, getty) from one another, or the system
	# bus's dbus-daemon from the session buses'. Those are started under their
	# profile by name, through this wrapper: from their conf.d files, which
	# replace OpenRC's start with apparmor-start.sh's, and from /etc/inittab.
	makefile root:root 0755 "$pkgdir"/usr/libexec/cervino/apparmor-exec <<'EOF'
#!/bin/sh
# apparmor-exec PROFILE COMMAND [ARG...]: runs COMMAND under the AppArmor
# profile PROFILE, or unconfined when that profile is not loaded (AppArmor
# turned off, or the profile removed).
profile=$1
shift
if grep -qs "^$profile (" /sys/kernel/security/apparmor/profiles; then
	exec aa-exec -p "$profile" -- "$@"
fi
exec "$@"
EOF
	makefile root:root 0644 "$pkgdir"/usr/libexec/cervino/apparmor-start.sh <<'EOF'
# Sourced by a service's conf.d file, which sets apparmor_profile: OpenRC's
# start, which the init script does not override, runs the daemon through
# apparmor-exec.
start() {
	local daemon="$command"
	command_args="$apparmor_profile $command $command_args"
	command=/usr/libexec/cervino/apparmor-exec
	default_start || return
	# stop looks for the daemon, not for the wrapper.
	service_set_value command "$daemon"
}
EOF
	makefile root:root 0644 "$pkgdir"/etc/conf.d/acpid <<'EOF'
apparmor_profile=busybox-acpid
. /usr/libexec/cervino/apparmor-start.sh
EOF
	makefile root:root 0644 "$pkgdir"/etc/conf.d/dbus <<'EOF'
apparmor_profile=dbus-system
. /usr/libexec/cervino/apparmor-start.sh
EOF
	# alpine-baselayout's inittab, with the gettys started through the wrapper.
	# The initramfs adds a plain getty for a serial console it finds; the live
	# image's lbu shim wraps that one on installed systems.
	makefile root:root 0644 "$pkgdir"/etc/inittab <<'EOF'
# /etc/inittab

::sysinit:/sbin/openrc sysinit
::sysinit:/sbin/openrc boot
::wait:/sbin/openrc default
# A new version of an atomic install, on trial, has started.
::once:/usr/libexec/cervino/boot-trial boot

# Set up a couple of getty's
tty1::respawn:/usr/libexec/cervino/apparmor-exec busybox-getty /sbin/getty 38400 tty1
tty2::respawn:/usr/libexec/cervino/apparmor-exec busybox-getty /sbin/getty 38400 tty2
tty3::respawn:/usr/libexec/cervino/apparmor-exec busybox-getty /sbin/getty 38400 tty3
tty4::respawn:/usr/libexec/cervino/apparmor-exec busybox-getty /sbin/getty 38400 tty4
tty5::respawn:/usr/libexec/cervino/apparmor-exec busybox-getty /sbin/getty 38400 tty5
tty6::respawn:/usr/libexec/cervino/apparmor-exec busybox-getty /sbin/getty 38400 tty6

# Put a getty on the serial port
#ttyS0::respawn:/usr/libexec/cervino/apparmor-exec busybox-getty /sbin/getty -L 115200 ttyS0 vt100

# Stuff to do for the 3-finger salute
::ctrlaltdel:/usr/sbin/reboot

# Stuff to do before rebooting
::shutdown:/sbin/openrc shutdown
::shutdown:/usr/libexec/cervino/boot-trial reboot
EOF

	# Alpine's gnome-shell (50) is newer than its gnome-session and GDM (48), and
	# misses two of their protocols, so this session helper stands in for it:
	# - it registers with gnome-session as a client (so that gnome-session, run
	#   without systemd, knows the shell is up) but never answers its
	#   QueryEndSession and EndSession signals, so every logout waits for the
	#   shell, listed as "Not responding".
	# - it calls GDM's RegisterSession without the a{sv} argument GDM 48 expects,
	#   so the call fails. GDM then takes the end of every session for a failure
	#   ("Session never registered, failing"): it logs the autologin user straight
	#   back in, and after a few such failures shows no login screen at all. The
	#   login screen's own session is no different: when a user logs in through
	#   it, GDM restarts the "failed" login screen, which takes the seat from the
	#   new session and dies, until GDM gives up and the screen stays frozen.
	# The login screen's gnome-session only autostarts what is in GDM's greeter
	# directory, so the helper is listed there too.
	makefile root:root 0755 "$pkgdir"/usr/libexec/cervino/gnome-shell-compat <<'EOF'
#!/usr/bin/gjs
// Registers the session with GDM and answers gnome-session's end-of-session
// queries on behalf of GNOME Shell
const {Gio, GLib} = imports.gi;
const bus = Gio.DBus.session;
const SM = 'org.gnome.SessionManager';
const SHELL_APP_ID = 'org.gnome.Shell.desktop';

function call(path, iface, method, args = null, ret = null) {
    return bus.call_sync(SM, path, iface, method, args,
        ret ? new GLib.VariantType(ret) : null, Gio.DBusCallFlags.NONE, 5000, null).deepUnpack();
}

// GDM finds the display from the caller's login session, which is this one.
Gio.DBus.system.call('org.gnome.DisplayManager', '/org/gnome/DisplayManager/Manager',
    'org.gnome.DisplayManager.Manager', 'RegisterSession', new GLib.Variant('(a{sv})', [{}]),
    null, Gio.DBusCallFlags.NONE, -1, null, (conn, res) => {
        try {
            conn.call_finish(res);
        } catch (e) {
            logError(e, 'registering the session with GDM');
        }
    });

bus.signal_subscribe(SM, `${SM}.ClientPrivate`, null, null, null, Gio.DBusSignalFlags.NONE,
    (_c, _sender, path, _iface, signal) => {
        if (signal !== 'QueryEndSession' && signal !== 'EndSession')
            return;
        try {
            const [appId] = call(path, `${SM}.Client`, 'GetAppId', null, '(s)');
            if (appId === SHELL_APP_ID) {
                call(path, `${SM}.ClientPrivate`, 'EndSessionResponse',
                    new GLib.Variant('(bs)', [true, '']));
            }
        } catch (e) {
            logError(e, `answering ${signal} for ${path}`);
        }
    });

new GLib.MainLoop(null, false).run();
EOF
	for dir in etc/xdg/autostart usr/share/gdm/greeter/autostart; do
		makefile root:root 0644 "$pkgdir"/$dir/gnome-shell-compat.desktop <<'EOF'
[Desktop Entry]
Type=Application
Name=GNOME Shell compatibility helper
Exec=/usr/libexec/cervino/gnome-shell-compat
OnlyShowIn=GNOME;
NoDisplay=true
EOF
	done

	# The SPICE agent needs uinput.
	makefile root:root 0644 "$pkgdir"/etc/modules-load.d/uinput.conf <<'EOF'
uinput
EOF
	# spice-vdagentd blocks writing to its virtio port while nothing on the host
	# reads it (no SPICE client), and then ignores SIGTERM: kill it after 5 s,
	# and remove the socket it then leaves behind, or it cannot start again.
	# Only a VM with a SPICE channel has the agent's virtio port (udev-settle
	# has created it by the default runlevel): anywhere else the daemon has
	# nothing to do, so the service is left inactive instead of started.
	makefile root:root 0644 "$pkgdir"/etc/conf.d/spice-vdagentd <<'EOF'
spice_port=/dev/virtio-ports/com.redhat.spice.0
retry="TERM/5/KILL/5"
start() {
	if [ ! -e "$spice_port" ]; then
		einfo "No SPICE channel, not starting ${name:-$RC_SVCNAME}"
		mark_service_inactive
		return 0
	fi
	default_start
}
stop() {
	[ -e "$spice_port" ] || return 0
	default_stop
}
stop_post() {
	rm -f /run/spice-vdagentd/spice-vdagent-sock
}
EOF

	makefile root:root 0644 "$pkgdir"/etc/flatpak/remotes.d/flathub.flatpakrepo \
		< "$startdir"/flathub.flatpakrepo
	# Only flatpak run as root adds those to the system installation; until
	# then users see no remotes.
	makefile root:root 0755 "$pkgdir"/etc/local.d/flatpak-remotes.start <<'EOF'
#!/bin/sh
flatpak remotes >/dev/null 2>&1 || true
EOF

	# GNOME Software lists Alpine's packages from the AppStream catalog of the
	# repositories in /etc/apk/repositories, which nothing fetches by default.
	# Fetch it daily (anacron, see above) and whenever a connection
	# comes up; only what changed is downloaded.
	makefile root:root 0755 "$pkgdir"/etc/periodic/daily/alpine-appstream <<'EOF'
#!/bin/sh
# NetworkManager's dispatcher runs this without /usr/sbin in PATH.
export PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
exec flock -n /run/alpine-appstream.lock alpine-appstream-downloader >/dev/null 2>&1
EOF
	makefile root:root 0755 "$pkgdir"/etc/NetworkManager/dispatcher.d/50-alpine-appstream <<'EOF'
#!/bin/sh
[ "$2" = up ] || exit 0
setsid /etc/periodic/daily/alpine-appstream </dev/null >/dev/null 2>&1 &
EOF

	# Atomic installs (the live image's installer, setup-disk shim, "atomic"):
	# a btrfs volume, encrypted or not, holds each version of the system as a
	# read-only subvolume, roots/<id> (the date and time it was made, so
	# newest last), with a writable /etc of its own as a nested subvolume,
	# beside @var and @home, which all versions share (and /root is
	# /var/roothome). update-alpine makes a new version from a snapshot of the
	# running one and upgrades that, then stages it; at shutdown the
	# cervino-atomic service brings the /etc changes made since into it and
	# makes it the one to boot, once on trial first. The firmware starts the
	# versions from the FAT boot partition (on a PC, UEFI's, mounted on
	# /boot/efi), which holds each one's kernel, initramfs and CPU microcode,
	# as the firmware cannot read an encrypted volume. update-boot keeps that
	# partition in step with the volume: the kernel hook below runs it after
	# building an initramfs, the package trigger when a package changes /boot
	# (microcode), and the service after switching. Each version's kernel
	# command line, but for the subvolume to mount, is its
	# /etc/kernel/cmdline, which only atomic installs have. These all share
	# atomic.sh.
	makefile root:root 0644 "$pkgdir"/usr/libexec/cervino/atomic.sh <<'EOF'
# Sourced by update-boot, update-alpine and the cervino-atomic service.
# The volume's top level holds roots/<id> and, while an update is staged,
# "staged" (the new version's id, then the id of the version it was made
# from, and "merge" if the /etc changes made since are to be brought into it)
# and etc-base, a read-only snapshot of /etc when it was staged.

# atomic_detect [ROOT]: whether ROOT (default /) is a version of an atomic
# install, mounted there (not a chroot into one being made); sets atomic_dev
# (the volume's device) and atomic_id (the version's id).
atomic_detect() {
	local root=${1:-/} d m t o _ subvolid=
	root=${root%/}
	atomic_dev= atomic_id=
	[ -f "$root"/etc/kernel/cmdline ] || return 1
	while read -r d m t o _; do
		[ "$m" = "${root:-/}" ] && [ "$t" = btrfs ] || continue
		atomic_dev=$d
		atomic_id=$(echo ",$o," | sed -n 's|.*,subvol=/roots/\([^,/]*\),.*|\1|p')
		subvolid=$(echo ",$o," | sed -n 's/.*,subvolid=\([0-9]*\),.*/\1/p')
	done < /proc/mounts
	[ -n "$atomic_id" ] &&
		[ "$(btrfs inspect-internal rootid "${root:-/}" 2>/dev/null)" = "$subvolid" ]
}

# atomic_mount: mounts the volume's top level on $top (in /run, which is
# still there at shutdown); atomic_umount undoes it.
atomic_mount() {
	top=$(mktemp -d /run/cervino-volume.XXXXXX) &&
		mount -t btrfs -o subvolid=5 "$atomic_dev" "$top"
}
atomic_umount() {
	umount "$top" 2>/dev/null
	rmdir "$top" 2>/dev/null
}

# atomic_staged: sets staged_id, staged_from and staged_merge from $top/staged
# (all empty when nothing is staged).
atomic_staged() {
	staged_id= staged_from= staged_merge=
	[ ! -f "$top"/staged ] || read -r staged_id staged_from staged_merge < "$top"/staged
}

# atomic_ready ID: whether version ID is complete: read-only, and not staged.
atomic_ready() {
	[ "$1" != "$staged_id" ] && [ -d "$top/roots/$1" ] &&
		[ "$(btrfs property get -ts "$top/roots/$1" ro 2>/dev/null)" = ro=true ]
}

# atomic_pi [ROOT]: whether ROOT (default /) is a Raspberry Pi's system (the
# firmware's files are in its /boot).
atomic_pi() {
	[ -f "${1%/}"/boot/start4.elf ] || [ -f "${1%/}"/boot/bootcode.bin ]
}

# atomic_trial [ROOT]: whether a new version of ROOT's system starts once
# on trial, with the running one to fall back on (see
# /usr/libexec/cervino/boot-trial): on a PC, which UEFI starts, and on a Pi
# whose firmware has tryboot.
atomic_trial() {
	if atomic_pi "$1"; then
		[ -e /proc/device-tree/chosen/bootloader/tryboot ]
	else
		[ -d /sys/firmware/efi ]
	fi
}

# atomic_failed ID: whether version ID did not start when it was tried.
atomic_failed() {
	grep -qx "$1" "$top"/boot-failed 2>/dev/null
}

# atomic_delete ID: deletes version ID.
atomic_delete() {
	local r=$top/roots/$1
	[ -n "$1" ] && [ -d "$r" ] || return 0
	btrfs property set -ts "$r" ro false 2>/dev/null
	[ ! -d "$r"/etc ] || btrfs -q subvolume delete "$r"/etc 2>/dev/null || rm -rf "${r:?}"/etc
	btrfs -q subvolume delete "$r"
}

# atomic_unstage: deletes the staged version, if any, and what goes with it.
atomic_unstage() {
	atomic_staged
	[ -z "$staged_id" ] || atomic_delete "$staged_id"
	[ ! -d "$top"/etc-base ] || btrfs -q subvolume delete "$top"/etc-base
	rm -f "$top"/staged
	staged_id= staged_from= staged_merge=
}

# atomic_gc: deletes all but the running version, the staged one and the
# newest four complete ones, and versions left incomplete.
atomic_gc() {
	local id n=0
	atomic_staged
	for id in $(ls -r "$top"/roots); do
		[ "$id" = "$atomic_id" ] || [ "$id" = "$staged_id" ] && continue
		if atomic_ready "$id" && [ "$n" -lt 4 ]; then
			n=$((n + 1))
			continue
		fi
		atomic_delete "$id"
	done
}
EOF
	makefile root:root 0755 "$pkgdir"/usr/libexec/cervino/update-boot <<'EOF'
#!/bin/sh
# update-boot [ROOT]: brings the boot partition in step with the complete
# versions of the system on ROOT's volume (ROOT defaults to /): puts each
# one's kernel, initramfs, CPU microcode and command line on it, removes
# those of versions that are gone, and chooses the version that starts.
# That is the version on ROOT, which has started, and a newer one, if there
# is one that did not fail to start before, is started once on trial (see
# /usr/libexec/cervino/boot-trial); with UPDATE_BOOT_COMMIT=1 that one
# starts from now on instead.
# On a PC (UEFI only) the boot partition is the EFI system partition,
# mounted on ROOT/boot/efi: each version is a unified kernel image (UKI)
# there, cervino/<id>/linux.efi, with a UEFI boot entry of its own. The
# version that starts is first in BootOrder, and also the firmware's
# fallback, EFI/BOOT/BOOTX64.EFI, for when the boot entries are lost; the one
# on trial is BootNext.
# On a Raspberry Pi it is the firmware's, mounted on ROOT/boot/firmware: each
# version's kernel, initramfs, device trees and overlays are in
# cervino/<id>/, config.txt starts one (os_prefix) and lists the others, and
# tryboot.txt, which the firmware reads instead for a restart with the
# tryboot flag, starts the one on trial. A Pi whose firmware has no tryboot
# starts the newest version.
# Does nothing but on an atomic install.
set -eu
. /usr/libexec/cervino/atomic.sh
root=${1:-/}
root=${root%/}
atomic_detect "$root" || exit 0

pi= esp=$root/boot/efi
if atomic_pi "$root"; then
	pi=1 esp=$root/boot/firmware
elif [ ! -d /sys/firmware/efi ]; then
	echo "update-boot: an atomic install starts only with UEFI, and this PC started without it" >&2
	exit 1
fi
if ! mountpoint -q "$esp"; then
	[ -z "$root" ] && mount "${esp#"$root"}" ||
		{ echo "update-boot: the boot partition is not mounted on $esp" >&2; exit 1; }
fi
atomic_mount
trap 'atomic_umount; rm -f "$top".cmdline' EXIT
atomic_staged

# copy FROM TO: replaces TO with FROM unless they are the same already. The
# copy is renamed into place, so TO is never half written.
copy() {
	cmp -s "$1" "$2" && return 0
	mkdir -p "${2%/*}"
	cp "$1" "$2".new
	mv "$2".new "$2"
}
# replace NEW FILE: renames NEW to FILE, unless they are the same.
replace() {
	if cmp -s "$1" "$2"; then rm -f "$1"; else mv "$1" "$2"; fi
}
made() {
	echo "$1" | sed -n 's/^\(....\)\(..\)\(..\)\(..\)\(..\).*/\1-\2-\3 \4:\5 UTC/p'
}
# pick_kernel ID: sets kernel to the kernel version ID starts with, empty if
# it has none: on a Pi as Alpine's config.txt would pick it, a variant
# (vmlinuz-rpi16k) over vmlinuz-rpi; on a PC lts over the others.
pick_kernel() {
	local k src=$top/roots/$1/boot
	kernel=
	if [ -n "$pi" ]; then
		set -- "$src"/vmlinuz-rpi "$src"/vmlinuz-rpi*
	else
		set -- "$src"/vmlinuz-* "$src"/vmlinuz-lts
	fi
	for k; do
		[ -f "$k" ] && [ -f "$src/initramfs-${k##*/vmlinuz-}" ] && kernel=${k##*/}
	done
	return 0
}

# Each complete version's boot files, newest first. They never change, but
# for the command line (the version's /etc/kernel/cmdline and the subvolume
# to mount), so they are made once.
keep=
for id in $(ls -r "$top"/roots); do
	atomic_ready "$id" && [ -f "$top/roots/$id"/etc/kernel/cmdline ] || continue
	pick_kernel "$id"
	[ -n "$kernel" ] || continue
	src=$top/roots/$id/boot dst=$esp/cervino/$id
	echo "$(cat "$top/roots/$id"/etc/kernel/cmdline) rootflags=subvol=/roots/$id" > "$top".cmdline
	if [ -n "$pi" ]; then
		# Into a directory renamed into place.
		if [ ! -d "$dst" ]; then
			rm -rf "$dst".new
			mkdir -p "$dst".new
			cp "$src/$kernel" "$src/initramfs-${kernel#vmlinuz-}" "$src"/*.dtb "$dst".new/
			cp -r "$src"/overlays "$dst".new/
			sync
			mv "$dst".new "$dst"
		fi
		# The firmware loads overlays from os_prefix's overlays/ only if it
		# has a README (else from the shared /overlays, which is not there),
		# and Alpine's kernel package ships none. Also added to versions
		# copied before it was.
		if [ ! -f "$dst"/overlays/README ]; then
			echo "Device tree overlays for this version of the system." > "$dst"/overlays/README.new
			mv "$dst"/overlays/README.new "$dst"/overlays/README
		fi
		copy "$top".cmdline "$dst"/cmdline.txt
	elif [ ! -f "$dst"/linux.efi ] || ! cmp -s "$top".cmdline "$dst"/cmdline; then
		# The microcode goes first, uncompressed, as the kernel looks for it
		# at the start of the initramfs.
		set --
		for ucode in amd-ucode.img intel-ucode.img; do
			[ ! -f "$src/$ucode" ] || set -- "$@" --initrd="$src/$ucode"
		done
		mkdir -p "$dst"
		ukify build --linux="$src/$kernel" "$@" --initrd="$src/initramfs-${kernel#vmlinuz-}" \
			--cmdline=@"$top".cmdline --os-release=@"$top/roots/$id"/usr/lib/os-release \
			--output="$dst"/linux.efi.new >/dev/null
		sync
		mv "$dst"/linux.efi.new "$dst"/linux.efi
		copy "$top".cmdline "$dst"/cmdline
	fi
	keep="$keep $id"
done
rm -f "$top".cmdline
[ -n "$keep" ] || { echo "update-boot: no kernel to boot on $atomic_dev" >&2; exit 1; }

# Which version starts, and which one is on trial. Failed versions that are
# gone are forgotten.
if [ -f "$top"/boot-failed ]; then
	ls "$top"/roots | grep -Fx -f "$top"/boot-failed > "$top"/boot-failed.new || :
	if [ -s "$top"/boot-failed.new ]; then
		mv "$top"/boot-failed.new "$top"/boot-failed
	else
		rm -f "$top"/boot-failed.new "$top"/boot-failed
	fi
fi
set -- $keep
start=$1 try=
case " $keep " in *" $atomic_id "*)
	if atomic_trial "$root"; then
		start=$atomic_id
		for id in $keep; do
			[ "$id" -gt "$start" ] || break
			atomic_failed "$id" || { try=$id; break; }
		done
		[ "${UPDATE_BOOT_COMMIT:-}" != 1 ] || [ -z "$try" ] || start=$try try=
	fi
esac

if [ -n "$pi" ]; then
	# config FILE ID: writes the config.txt that starts version ID to FILE.
	config() {
		pick_kernel "$2"
		{
			echo "# Written by /usr/libexec/cervino/update-boot, which replaces any changes:"
			echo "# put your own settings in usercfg.txt."
			echo "# This version of the system, made $(made "$2"):"
			echo "os_prefix=cervino/$2/"
			echo "kernel=$kernel"
			echo "initramfs initramfs-${kernel#vmlinuz-}"
			echo "arm_64bit=1"
			echo "include usercfg.txt"
		} > "$1"
	}
	conf=$esp/config.txt
	config "$conf".new "$start"
	others=
	for id in $keep; do
		[ "$id" != "$start" ] || continue
		[ -n "$others" ] || {
			echo "# Other versions: to start one, put it in os_prefix above (on another"
			echo "# computer if this one does not start), or run update-alpine rollback."
		} >> "$conf".new
		others=1
		note=
		[ "$id" != "$try" ] || note=", tried once with tryboot.txt at the next restart"
		! atomic_failed "$id" || note=", did not start"
		echo "#os_prefix=cervino/$id/  (made $(made "$id")$note)" >> "$conf".new
	done
	if [ -n "$try" ]; then
		config "$esp"/tryboot.txt.new "$try"
		{
			echo "# The firmware reads this file instead of config.txt when the machine is"
			echo "# restarted to try this version (see /usr/libexec/cervino/boot-trial)."
		} >> "$esp"/tryboot.txt.new
	fi
	# The firmware, from the version that starts.
	for f in "$top/roots/$start"/boot/bootcode.bin "$top/roots/$start"/boot/start*.elf \
		"$top/roots/$start"/boot/fixup*.dat; do
		[ ! -f "$f" ] || copy "$f" "$esp/${f##*/}"
	done
	sync
	replace "$conf".new "$conf"
	if [ -n "$try" ]; then
		replace "$esp"/tryboot.txt.new "$esp"/tryboot.txt
	else
		rm -f "$esp"/tryboot.txt
	fi
else
	copy "$esp/cervino/$start"/linux.efi "$esp"/EFI/BOOT/BOOTX64.EFI
	sync
	# The boot entries, "Alpine Linux" and the date and time the version was
	# made, on this partition (other disks' are left alone). entries prints
	# each one's number and version, or "-" for the one that started Limine,
	# which atomic installs used before.
	part=$(awk -v m="$esp" '$2 == m { print $1 }' /proc/mounts)
	part=$(basename "$(readlink -f "$part")")
	disk=/dev/$(basename "$(readlink -f /sys/class/block/"$part"/..)")
	partuuid=$(blkid -s PARTUUID -o value /dev/"$part" | tr 'A-F' 'a-f')
	[ -n "$partuuid" ] || { echo "update-boot: no PARTUUID for /dev/$part" >&2; exit 1; }
	entries() {
		efibootmgr -v | awk -v uuid="$partuuid" '
			/^Boot[0-9A-Fa-f][0-9A-Fa-f][0-9A-Fa-f][0-9A-Fa-f]/ && index(tolower($0), uuid) {
				label = $0
				sub(/^Boot[0-9A-Fa-f]+\*? /, "", label)
				sub(/\t.*/, "", label)
				if (label ~ /^Alpine Linux [0-9]+-[0-9]+-[0-9]+ [0-9]+:[0-9]+:[0-9]+$/) {
					gsub(/[^0-9]/, "", label)
					print substr($1, 5, 4), label
				} else if (label == "Alpine Linux")
					print substr($1, 5, 4), "-"
			}'
	}
	efi() {
		efibootmgr -q "$@" >/dev/null || { echo "update-boot: efibootmgr $* failed" >&2; exit 1; }
	}
	ents=$(entries)
	for n in $(echo "$ents" | awk -v keep=" $keep " 'NF && !index(keep, " " $2 " ") { print $1 }'); do
		efi -b "$n" -B
	done
	for id in $keep; do
		echo "$ents" | grep -q " $id$" && continue
		efi --create --disk "$disk" --part "$(cat /sys/class/block/"$part"/partition)" \
			--loader "\\cervino\\$id\\linux.efi" \
			--label "Alpine Linux $(echo "$id" | sed 's/^\(....\)\(..\)\(..\)\(..\)\(..\)\(..\)$/\1-\2-\3 \4:\5:\6/')"
	done
	ents=$(entries)
	num() {
		echo "$ents" | awk -v id="$1" '$2 == id { print $1; exit }'
	}
	# BootOrder: the version that starts, the others, newest first, then
	# whatever else was there.
	order=$(num "$start")
	for id in $keep; do
		[ "$id" = "$start" ] || order="$order,$(num "$id")"
	done
	for n in $(efibootmgr | sed -n 's/^BootOrder: //p' | tr , ' '); do
		echo "$ents" | grep -qi "^$n " || order="$order,$n"
	done
	efi -o "$order"
	next=$(efibootmgr | sed -n 's/^BootNext: //p')
	if [ -n "$try" ]; then
		efi -n "$(num "$try")"
	elif [ -n "$next" ] && echo "$ents" | grep -qi "^$next "; then
		efi -N
	fi
	# Limine's files and the kernels it started, from before.
	rm -rf "$esp"/limine
	for dir in "$esp"/cervino/*; do
		rm -f "$dir"/vmlinuz-* "$dir"/initramfs-* "$dir"/*-ucode.img
	done
fi

# For the next start: the version on trial, on the volume to tell whether it
# started, and in /run for update-alpine list and the shutdown.
if [ -z "$root" ]; then
	if [ -n "$try" ]; then
		echo "$try" > "$top"/boot-trying
		echo "$try" > /run/cervino-trial
	else
		rm -f "$top"/boot-trying /run/cervino-trial
	fi
fi
for dir in "$esp"/cervino/*; do
	case " $keep " in *" ${dir##*/} "*) ;; *) rm -rf "$dir" ;; esac
done
sync
EOF
	# kernel-hooks runs this when a kernel, or a package with modules for one,
	# is installed, upgraded or removed. The installer turns mkinitfs's own
	# trigger off on atomic installs (disable_trigger in mkinitfs.conf), so
	# the initramfs is built here, and copied to the boot partition only once
	# it is (update-boot does nothing in update-alpine's chroot of a new
	# version, which is copied there once it is complete).
	makefile root:root 0755 "$pkgdir"/etc/kernel-hooks.d/50-cervino-boot <<'EOF'
#!/bin/sh
# Arguments: flavor, new version (empty if removed), old version.
flavor=$1 new=$2
[ -f /etc/kernel/cmdline ] || exit 0
if [ -n "$new" ]; then
	mkinitfs -o /boot/initramfs-"$flavor" "$new-$flavor" || exit
elif [ ! -e /boot/vmlinuz-"$flavor" ]; then
	rm -f /boot/initramfs-"$flavor"
fi
exec /usr/libexec/cervino/update-boot
EOF

	# At shutdown, the staged version is finished and made the one to boot:
	# the service runs in the shutdown runlevel, after the others have
	# stopped, and before the file systems are made read-only.
	makefile root:root 0755 "$pkgdir"/usr/libexec/cervino/atomic-finalize <<'EOF'
#!/bin/sh
# atomic-finalize: if update-alpine staged a version made from the running
# one, brings the changes made to /etc since it was staged into it (where
# the update changed a file that was changed meanwhile too, the update's copy
# is kept next to it as .apk-new, as apk does), makes it the one to boot and
# deletes old versions. A version staged from another one (the machine was
# started from another version since) is deleted.
. /usr/libexec/cervino/atomic.sh
atomic_detect || exit 0
exec 9> /run/cervino-update.lock
flock 9
atomic_mount || exit 1
list=$top.list
trap 'atomic_umount; rm -f "$list" "$list".del' EXIT
atomic_staged
[ -n "$staged_id" ] || exit 0
if [ "$staged_from" != "$atomic_id" ]; then
	echo "Deleting the update staged from another version of the system"
	atomic_unstage
	exit 0
fi
echo "Switching to the updated system"
if [ "$staged_merge" = merge ]; then
	new=$top/roots/$staged_id/etc base=$top/etc-base
	# What changed in /etc since the snapshot: what rsync would change in
	# the snapshot to make it the same (the name follows the 11 characters
	# of the change and a space).
	: > "$list.del"
	rsync -a -n -i -c --delete /etc/ "$base"/ |
		awk -v chg="$list" -v del="$list.del" '{
			name = substr($0, 13)
			if ($1 == "*deleting") { print name > del; next }
			sub(/ -> .*/, "", name)
			print name > chg
		}'
	touch "$list"
	while IFS= read -r p; do
		p=${p%/}
		[ -f "/etc/$p" ] && [ ! -L "/etc/$p" ] && [ -f "$new/$p" ] && [ -f "$base/$p" ] || continue
		cmp -s "$new/$p" "$base/$p" || cmp -s "$new/$p" "/etc/$p" || cp -a "$new/$p" "$new/$p.apk-new"
	done < "$list"
	rsync -a --files-from="$list" /etc/ "$new"/
	# Deleted since: deleted from the new version too, unless the update
	# changed them. Directories after what is in them.
	sort -r "$list.del" | while IFS= read -r p; do
		p=${p%/}
		if [ -L "$new/$p" ]; then
			[ "$(readlink "$new/$p")" = "$(readlink "$base/$p")" ] && rm -f "$new/$p"
		elif [ -d "$new/$p" ]; then
			rmdir "$new/$p" 2>/dev/null
		elif [ -e "$new/$p" ]; then
			cmp -s "$new/$p" "$base/$p" && rm -f "$new/$p"
		fi
	done
	btrfs -q subvolume delete "$base"
fi
rm -f "$top"/staged
sync
atomic_gc
/usr/libexec/cervino/update-boot
EOF
	makefile root:root 0755 "$pkgdir"/etc/init.d/cervino-atomic <<'EOF'
#!/sbin/openrc-run
description="Switches to the update update-alpine staged"

depend() {
	before killprocs mount-ro savecache
}

start() {
	/usr/libexec/cervino/atomic-finalize
	/usr/libexec/cervino/boot-trial shutdown
	return 0
}
EOF

	# A new version starts once on trial, with the running one to fall back
	# on, in place of a boot menu.
	makefile root:root 0755 "$pkgdir"/usr/libexec/cervino/boot-trial <<'EOF'
#!/bin/sh
# boot-trial boot|shutdown|reboot: a new version of an atomic install starts
# once on trial, with the version that last started to fall back on.
# update-boot keeps the firmware starting the running version (it started),
# and starting the newest one once, if it is newer and did not fail to start
# before: on a PC as UEFI's BootNext, which the firmware clears as it starts
# it, on a Raspberry Pi as tryboot.txt, which the firmware reads instead of
# config.txt at a restart with the tryboot flag. It notes that version in
# boot-trying on the volume and in /run/cervino-trial. Once the default
# runlevel has started (boot, run by init), a version on trial that is
# running has started, and update-boot makes it the one that starts; one
# that is not has failed (the machine was switched off and on, and started
# the version before), and is noted in boot-failed on the volume, and not
# tried again.
# The Pi's kernel passes the tryboot flag to the firmware only with a
# restart's argument (reboot "0 tryboot"), which busybox init cannot give:
# after the shutdown runlevel, with the file systems read-only, init runs
# reboot, which restarts so. Init does not tell it whether it is to restart
# or power off, so elogind's shutdown hook and the reboot wrapper note a
# restart in /run/cervino-reboot. The firmware cannot try a version after a
# power off, so then (shutdown, run by the cervino-atomic service) the new
# version is made the one that starts, with nothing to fall back on.
. /usr/libexec/cervino/atomic.sh
case $1 in
boot)
	atomic_detect && atomic_trial || exit 0
	exec 9> /run/cervino-update.lock
	flock 9
	atomic_mount || exit 1
	if [ -f "$top"/boot-trying ]; then
		read -r trying < "$top"/boot-trying
		if [ "$trying" != "$atomic_id" ]; then
			echo "$trying" >> "$top"/boot-failed
			logger -t cervino "The updated system ($trying) did not start: $atomic_id started instead"
		fi
		rm -f "$top"/boot-trying
		sync
	fi
	atomic_umount
	/usr/libexec/cervino/update-boot 2>&1 | logger -t update-boot
	;;
shutdown)
	[ -f /run/cervino-trial ] && atomic_detect && atomic_pi && atomic_trial || exit 0
	# Restarting (and /etc/inittab, unless changed and kept from before,
	# has reboot): tried.
	[ -f /run/cervino-reboot ] &&
		grep -q '^::shutdown:/usr/libexec/cervino/boot-trial reboot$' /etc/inittab && exit 0
	exec 9> /run/cervino-update.lock
	flock 9
	UPDATE_BOOT_COMMIT=1 /usr/libexec/cervino/update-boot
	;;
reboot)
	[ -f /run/cervino-reboot ] && [ -f /run/cervino-trial ] && atomic_pi || exit 0
	echo "Restarting to try the updated system"
	sync
	/usr/libexec/cervino/tryboot
	;;
esac
exit 0
EOF
	# The Pi's restart with the tryboot flag, for boot-trial reboot.
	if [ "$TARGET_ARCH" = aarch64 ]; then
		install -Dm755 "$srcdir"/tryboot "$pkgdir"/usr/libexec/cervino/tryboot
	fi
	# elogind runs this before it restarts or switches off the machine, with
	# which as its argument.
	makefile root:root 0755 "$pkgdir"/usr/libexec/elogind/system-shutdown/cervino-reboot <<'EOF'
#!/bin/sh
# Notes a restart for /usr/libexec/cervino/boot-trial.
[ "$1" != reboot ] || : > /run/cervino-reboot
EOF
	# reboot, found before busybox's /sbin/reboot in PATH: the same, noting
	# the restart for /usr/libexec/cervino/boot-trial.
	makefile root:root 0755 "$pkgdir"/usr/sbin/reboot <<'EOF'
#!/bin/sh
: > /run/cervino-reboot 2>/dev/null
exec /sbin/reboot "$@"
EOF

	# apk on an atomic install: apk cannot change the read-only system, so
	# this wrapper, found before /sbin/apk in PATH (/etc/profile's and doas's
	# alike), hands apk add, del and upgrade to update-alpine, which makes them
	# in a new version of the system, and turns down other changes. Anywhere
	# else (the live system, sys installs, update-alpine's chroot of a new
	# version), for anything that only reads, and for another root (--root),
	# it is apk itself.
	makefile root:root 0755 "$pkgdir"/usr/sbin/apk <<'EOF'
#!/bin/sh
# apk, on an atomic install: add, del and upgrade go through update-alpine.
real=/sbin/apk
lib=/usr/libexec/cervino/atomic.sh
[ -f "$lib" ] || exec "$real" "$@"
. "$lib"
atomic_detect 2>/dev/null || exec "$real" "$@"

refuse() {
	cat >&2 <<MSG
apk: this system is read-only (an atomic install), so apk cannot $1 it.
Instead, as root:
  update-alpine add PACKAGE...   adds packages
  update-alpine del PACKAGE...   removes them
  update-alpine                  upgrades everything
Each makes a new version of the system, which it starts with next time.
MSG
	exit 1
}

# The applet is the first argument that is not an option (or an option's
# value). Options that only change what apk prints, or refresh the indexes
# (in /var, which is writable), can be passed on; any other one is turned
# down, as update-alpine would not do what it asks.
applet= pkgs= odd=
skip=
for a; do
	if [ -n "$skip" ]; then skip=; continue; fi
	case $a in
	-s|--simulate|-p|--root|--root=*|-h|--help) exec "$real" "$@" ;;
	-U|--update-cache|-q|--quiet|-v|--verbose|--progress|--no-progress|--interactive|-i) ;;
	-X|--repository|-t|--virtual|--arch|--cache-dir|--keys-dir|--repositories-file|--from|--cache-max-age)
		odd=1 skip=1 ;;
	-*) odd=1 ;;
	*)
		if [ -z "$applet" ]; then
			applet=$a
		else
			case $a in */*|*.apk) odd=1 ;; esac
			pkgs="$pkgs $a"
		fi ;;
	esac
done

case $applet in
add|del)
	[ -z "$odd" ] && [ -n "$pkgs" ] || refuse "change"
	echo "apk: this system is read-only (an atomic install): update-alpine $applet makes the change in a new version of it, which it starts with next time." >&2
	# shellcheck disable=SC2086
	exec update-alpine "$applet" $pkgs ;;
upgrade)
	[ -z "$odd" ] && [ -z "$pkgs" ] || refuse "upgrade"
	echo "apk: this system is read-only (an atomic install): update-alpine upgrades it in a new version, which it starts with next time." >&2
	exec update-alpine ;;
fix)
	refuse "fix" ;;
esac
exec "$real" "$@"
EOF

	# "Update Alpine Linux" in the app grid: upgrades the packages, then offers
	# a newer stable Alpine release, if there is one, the way Alpine's release
	# notes say to upgrade (repositories moved to the new branch, apk-tools
	# first, then everything with --available). cervino-desktop's repo, where
	# it is configured, moves along with them, so the release is only offered
	# once that repo has it. Root's shell can run it as update-alpine, which
	# also adds and removes packages (update-alpine add/del), as apk cannot on
	# an atomic install's read-only system, and goes back to the version
	# before (update-alpine rollback), lists the versions (update-alpine list)
	# and deletes ones (update-alpine delete). On an atomic install it does all that
	# to a new version of the system, made from the running one and upgraded
	# in a chroot (which shares /var), and stages it for the next start.
	makefile root:root 0755 "$pkgdir"/usr/sbin/update-alpine <<'EOF'
#!/bin/sh
# update-alpine: upgrades the installed packages, then offers to upgrade the
# system to a newer stable Alpine release when one is out.
# update-alpine add|del PACKAGE...: adds or removes packages.
# update-alpine rollback: goes back to the version of the system before the
# running one (atomic installs only).
# update-alpine list: lists the versions of the system, newest first, and
# update-alpine delete ID...: deletes versions (atomic installs only).
# On an atomic install, the running system is left as it is: the changes go
# into a new version, which the system starts with next time.
set -u
# Neither Ctrl-C nor closing the terminal stops apk halfway through; a
# question then reads end of file, which answers no.
trap '' HUP INT

repos=/etc/apk/repositories
list=/etc/apk/repositories.d/cervino.list

ask() {
	printf '\n%s [y/N] ' "$1"
	read -r answer || return 1
	case $answer in [Yy]*) return 0 ;; esac
	return 1
}
die() {
	echo "update-alpine: $*" >&2
	exit 1
}

[ "$(id -u)" = 0 ] || { echo "update-alpine: run it as root (doas update-alpine)" >&2; exit 1; }
cmd=${1:-upgrade}
case $cmd in
upgrade|rollback|list) [ $# -le 1 ] ;;
add|del|delete) [ $# -ge 2 ] ;;
*) false ;;
esac || die "usage: update-alpine [add PACKAGE... | del PACKAGE... | rollback | list | delete ID...]"
[ $# = 0 ] || shift

# On an atomic install, $R is the new version, and run runs a command in it.
atomic= R= new= made_base= mounts=
lib=/usr/libexec/cervino/atomic.sh
if [ -f "$lib" ] && . "$lib" && atomic_detect; then
	atomic=1
fi
[ -n "$atomic" ] || case $cmd in rollback|list|delete) false ;; esac ||
	die "$cmd only works on an atomic install"
run() {
	if [ -n "$atomic" ]; then chroot "$R" "$@"; else "$@"; fi
}
# Takes the new version's mounts down, and unless it was staged, deletes it.
cleanup() {
	for m in $mounts; do umount "$m"; done
	mounts=
	[ -z "$new" ] || atomic_delete "$new"
	[ -z "$made_base" ] || btrfs -q subvolume delete "$top"/etc-base
	atomic_umount
}
# The packages and lists that make the system, to tell whether it changed.
state() {
	cat "$R"/lib/apk/db/installed "$R"/etc/apk/world "$R$repos" 2>/dev/null | md5sum
}
# finish: the end. On an atomic install, stages the new version, if it
# differs from the one it was made from.
finish() {
	[ -n "$atomic" ] || exit 0
	for m in $mounts; do umount "$m"; done
	mounts=
	sync
	if [ "$cmd" != rollback ] && [ "$(state)" = "$before" ]; then
		echo
		if [ -n "$staged_id" ]; then
			echo "An update is waiting already: the system starts with it next time."
		else
			echo "There are no updates."
		fi
		exit 0
	fi
	btrfs property set -ts "$R" ro true || die "could not make the new version read-only"
	printf '%s %s %s\n' "$new" "$atomic_id" "$merge" > "$top"/staged.new &&
		mv "$top"/staged.new "$top"/staged || die "could not stage the new version"
	if [ -n "$staged_id" ] && [ "$staged_id" = "$src" ]; then
		atomic_delete "$staged_id"
	fi
	new= made_base=
	sync
	echo
	if [ "$cmd" = rollback ]; then
		echo "The system goes back to the version of $(made "$src") when it next starts."
	else
		echo "The update is ready: the system starts with it next time. The version"
		if ! atomic_trial; then
			echo "running now is kept: update-alpine rollback goes back to it."
		elif atomic_pi; then
			echo "running now is kept, and starts again if the update does not (switch the"
			echo "Pi off and on then). Switching the Pi off, rather than restarting it,"
			echo "starts the update with nothing to fall back on."
		else
			echo "running now is kept, and starts again if the update does not (switch the"
			echo "computer off and on then)."
		fi
	fi
	ask "Restart now?" && reboot
	exit 0
}
# made ID: when version ID was made.
made() {
	echo "$1" | sed -n 's/^\(....\)\(..\)\(..\)\(..\)\(..\).*/\1-\2-\3 \4:\5 UTC/p'
}

# update-alpine list: each version's id, when it was made, and which is
# running and which the system starts with next time: the staged update, or
# else the version on trial, else the running one (or where there are no
# trials, a Pi without tryboot, the newest complete version).
if [ "$cmd" = list ]; then
	atomic_mount || die "could not mount $atomic_dev"
	trap atomic_umount EXIT
	atomic_staged
	next=
	[ -z "$staged_id" ] || [ "$staged_from" != "$atomic_id" ] || next=$staged_id
	if [ -z "$next" ] && atomic_trial; then
		next=$atomic_id
		[ ! -f /run/cervino-trial ] || read -r next < /run/cervino-trial
	fi
	for id in $(ls -r "$top"/roots); do
		[ -n "$next" ] || ! atomic_ready "$id" || next=$id
		note=
		[ "$id" != "$atomic_id" ] || note="running"
		if [ "$id" = "$staged_id" ] && [ "$id" != "$next" ]; then
			note="update made from another version, deleted at shutdown"
		elif [ "$id" = "$staged_id" ]; then
			note="update"
		elif ! atomic_ready "$id"; then
			note="incomplete: an update being made, or one that was stopped"
		elif atomic_failed "$id"; then
			note="${note:+$note, }did not start when tried"
		fi
		[ "$id" != "$next" ] || note="${note:+$note, }starts next time"
		printf '%s  %s  %s\n' "$id" "$(made "$id")" "$note"
	done
	exit 0
fi

# update-alpine delete ID...: deletes those versions (the staged update with
# what goes with it), then brings the boot partition in step. The running
# version cannot be deleted, so there is always one left to start.
if [ "$cmd" = delete ]; then
	exec 9> /run/cervino-update.lock
	flock -n 9 || die "an update is running"
	atomic_mount || die "could not mount $atomic_dev"
	trap atomic_umount EXIT
	atomic_staged
	for id; do
		case $id in ''|*[!0-9]*) false ;; *) [ -d "$top/roots/$id" ] ;; esac ||
			die "there is no version $id (update-alpine list shows them)"
		[ "$id" != "$atomic_id" ] || die "$id is the running version"
	done
	for id; do
		if [ "$id" = "$staged_id" ]; then
			echo "Deleting the update $id"
			atomic_unstage || die "could not delete $id"
		else
			echo "Deleting $id"
			atomic_delete "$id" || die "could not delete $id"
		fi
	done
	sync
	/usr/libexec/cervino/update-boot || die "could not update the boot partition"
	exit 0
fi

if [ -n "$atomic" ]; then
	exec 9> /run/cervino-update.lock
	flock -n 9 || die "another update is running"
	atomic_mount || die "could not mount $atomic_dev"
	trap cleanup EXIT
	atomic_staged
	# Staged from another version (which the machine started with since,
	# before that one's shutdown could switch to it), or replaced by a
	# rollback: deleted.
	if [ -n "$staged_id" ] && { [ "$staged_from" != "$atomic_id" ] || [ "$cmd" = rollback ]; }; then
		atomic_unstage
	fi
	atomic_gc
	# The new version is a copy of the staged one, if any (so updates add
	# up until the next start), else of the running one, whose /etc is
	# snapshotted for the shutdown to bring later changes into it. A
	# rollback copies the newest complete version older than the running
	# one, /etc as it was.
	merge=merge
	if [ "$cmd" = rollback ]; then
		src= merge= seen=
		for id in $(ls -r "$top"/roots); do
			[ -n "$seen" ] && atomic_ready "$id" && { src=$id; break; }
			[ "$id" != "$atomic_id" ] || seen=1
		done
		[ -n "$src" ] || die "there is no earlier version to go back to"
		etc=$top/roots/$src/etc
	elif [ -n "$staged_id" ]; then
		src=$staged_id merge=$staged_merge etc=$top/roots/$staged_id/etc
	else
		src=$atomic_id etc=$top/etc-base
		[ -d "$etc" ] || { btrfs -q subvolume snapshot -r "$top/roots/$atomic_id"/etc "$etc" && made_base=1; } ||
			die "could not snapshot /etc"
	fi
	id=$(date -u +%Y%m%d%H%M%S)
	while [ -e "$top/roots/$id" ]; do sleep 1; id=$(date -u +%Y%m%d%H%M%S); done
	new=$id R=$top/roots/$id
	btrfs -q subvolume snapshot "$top/roots/$src" "$R" && rmdir "$R"/etc &&
		btrfs -q subvolume snapshot "$etc" "$R"/etc || die "could not copy the system"
	[ "$cmd" != rollback ] || finish
	for d in proc sys dev var; do
		mount --bind /"$d" "$R/$d" || die "could not mount /$d in the new version"
		mounts="$R/$d $mounts"
	done
	for d in run tmp; do
		mount -t tmpfs "$d" "$R/$d" || die "could not mount /$d in the new version"
		mounts="$R/$d $mounts"
	done
	before=$(state)
fi

case $cmd in
add|del)
	run apk "$cmd" --update-cache "$@" || exit
	finish ;;
esac

echo "Updating the installed packages..."
run apk upgrade --update-cache || exit

# The release branch the repositories point at; nothing to offer on edge.
read -r mirror current <<REPO
$(sed -nE 's#^[[:space:]]*(https?://[^[:space:]]*)/(v[0-9]+\.[0-9]+)/main/?[[:space:]]*$#\1 \2#p' "$R$repos" | head -n1)
REPO
[ -n "${current:-}" ] || finish
arch=$(apk --print-arch)
latest=$(wget -qO- -T 20 "$mirror/latest-stable/releases/$arch/latest-releases.yaml" |
	awk '/branch:/ { print $2; exit }')
case $latest in v[0-9]*.[0-9]*) ;; *)
	echo
	echo "Could not find out the latest Alpine release from $mirror."
	finish
esac
echo "${current#v} ${latest#v}" | awk '{
	split($1, c, "."); split($2, l, ".")
	exit !(l[1] > c[1] || (l[1] == c[1] && l[2] > c[2]))
}' || { echo; echo "Alpine Linux ${current#v} is the latest release."; finish; }

cervino=
if [ -f "$R$list" ]; then
	cervino=$(sed -nE 's#^[[:space:]]*(https?://[^[:space:]]*).*#\1#p' "$R$list" | head -n1)
	case $cervino in */"$current")
		cervino=${cervino%/*}/$latest
		if ! wget -q -T 20 --spider "$cervino/$arch/APKINDEX.tar.gz" 2> /dev/null; then
			echo
			echo "Alpine Linux ${latest#v} is out, but Cervino's packages for it are"
			echo "not published yet. Try again later."
			finish
		fi ;;
	*) cervino= ;;
	esac
fi

echo
echo "Alpine Linux ${latest#v} is available (this system runs ${current#v})."
ask "Upgrade to Alpine Linux ${latest#v} now?" || finish

cp "$R$repos" "$R$repos.update-alpine"
[ -z "$cervino" ] || cp "$R$list" "$R$list.update-alpine"
sed -i "s#/$(echo "$current" | sed 's/\./\\./g')/#/$latest/#g" "$R$repos"
[ -z "$cervino" ] || echo "$cervino" > "$R$list"
if ! run apk update; then
	mv "$R$repos.update-alpine" "$R$repos"
	[ -z "$cervino" ] || mv "$R$list.update-alpine" "$R$list"
	echo
	echo "Could not fetch Alpine Linux ${latest#v}'s package lists; nothing was changed."
	exit 1
fi
rm -f "$R$repos.update-alpine" "$R$list.update-alpine"
if ! run apk add --upgrade apk-tools || ! run apk upgrade --available; then
	echo
	if [ -n "$atomic" ]; then
		echo "The upgrade did not finish; nothing was changed."
	else
		echo "The upgrade did not finish. Once the problem above is fixed, finish it"
		echo "with: doas apk upgrade --available"
	fi
	exit 1
fi
# The new cervino-desktop brings the list just written; apk writes it as
# .apk-new, as the file was changed.
if [ -n "$cervino" ] && cmp -s "$R$list" "$R$list.apk-new"; then
	rm -f "$R$list.apk-new"
fi
[ -z "$atomic" ] || finish
sync

echo
echo "The system now runs Alpine Linux ${latest#v}. Restart to finish the upgrade."
ask "Restart now?" && reboot
exit 0
EOF
	# GLib's fallback terminal list has no GNOME Console, so Terminal=true
	# would not work; kgx is run directly. The window stays open so the last
	# messages can be read.
	makefile root:root 0644 "$pkgdir"/usr/share/applications/update-alpine.desktop <<'EOF'
[Desktop Entry]
Type=Application
Name=Update Alpine Linux
Comment=Install package updates and newer Alpine Linux releases
Exec=kgx -T "Update Alpine Linux" -- sh -c "doas /usr/sbin/update-alpine; echo; printf 'Press Enter to close. '; read -r _"
Icon=software-update-available
Categories=System;
EOF
}
