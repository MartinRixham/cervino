# Ours, after Raspberry Pi OS's: they are made for glibc and GCC 14, and
# VLC's Qt interface would run on Xwayland in a Wayland session.
source="$source rpi-musl-gcc15.patch rpi-qt-wayland.patch"
builddir="$srcdir/vlc-$_pkgver"

