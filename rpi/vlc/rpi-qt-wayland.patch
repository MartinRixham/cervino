VLC's Qt interface runs Qt on X11 whenever an X server answers, so in a
Wayland session (GNOME's) it runs through Xwayland and shows video with
EGL there: frames come late and the video stutters. On Wayland, Qt's
wayland platform lets the vout use wl_dmabuf, which hands the decoder's
frames to the compositor. Try Wayland first, then X11. QT_QPA_PLATFORM=xcb
still picks X11.

--- a/modules/gui/qt/qt.cpp
+++ b/modules/gui/qt/qt.cpp
@@ -474,16 +474,16 @@
     intf_thread_t *p_intf = (intf_thread_t *)p_this;
     void *(*thread)(void *) = Thread;
 
-#ifdef QT5_HAS_X11
-    if( HasX11( p_this ) )
-        thread = ThreadXCB;
-    else
-#endif
 #ifdef QT5_HAS_WAYLAND
     if( HasWayland() )
         thread = ThreadWayland;
     else
 #endif
+#ifdef QT5_HAS_X11
+    if( HasX11( p_this ) )
+        thread = ThreadXCB;
+    else
+#endif
 #if defined (QT5_HAS_X11) || defined (QT5_HAS_WAYLAND)
         return VLC_EGENERIC;
 #endif
