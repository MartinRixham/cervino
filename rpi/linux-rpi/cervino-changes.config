# Ours, applied after common-changes.config, as CONFIG_X=y, =m or =n.
#
# The virtio drivers test/kernel.sh's VM (QEMU's virt machine) boots with,
# its devices on virtio-mmio. Modules, which a Pi never loads.
CONFIG_VIRTIO_MMIO=m
CONFIG_VIRTIO_BLK=m
CONFIG_VIRTIO_NET=m
CONFIG_DRM_VIRTIO_GPU=m
CONFIG_SND_VIRTIO=m
