kmsro, which pairs a display-only device (the Pi's vc4) with a render
device (its v3d), keeps a dup() of the render node it found, without the
close-on-exec flag the loader opened it with. Every program a process
using it starts inherits the render node, and with it that process's GPU
memory, which a program that outlives it keeps: GNOME Shell's, after it
crashed or logged out, in a zellij server started from foot, hundreds of
MB of the Pi's 4 GB GPU address space each time. Duplicate it with
close-on-exec.

--- a/src/gallium/winsys/kmsro/drm/kmsro_drm_winsys.c
+++ b/src/gallium/winsys/kmsro/drm/kmsro_drm_winsys.c
@@ -39,6 +39,7 @@
 #include "pipe/p_screen.h"
 #include "pipe-loader/pipe_loader.h"
 #include "renderonly/renderonly.h"
+#include "util/os_file.h"
 #include "util/u_memory.h"
 
 #include "loader.h"
@@ -73,7 +74,7 @@ struct pipe_screen *kmsro_drm_screen_create(int kms_fd,
          goto out;
 
       ro->kms_fd = kms_fd;
-      ro->gpu_fd = dup(gpu_fds[i]);
+      ro->gpu_fd = os_dupfd_cloexec(gpu_fds[i]);
 
       render_dev_name = loader_get_kernel_driver_name(ro->gpu_fd);
       if (!render_dev_name) {
