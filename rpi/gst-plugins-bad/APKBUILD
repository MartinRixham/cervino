maintainer="team/alpine-desktop <achill@achill.org>"
#
# Alpine's community/gst-plugins-bad (_alpine below) with Raspberry Pi OS's
# patches for the Pi's HEVC decoder (rpi-hevc-dec, Pi 4 and 5), which
# v4l2codecs' v4l2slh265dec drives through the V4L2 request API: the slice
# bit size and data offset as the driver reads them, and its SAND output
# formats, which Raspberry Pi's kernel names Nc12 and Nc30 (mainline's
# NC12 is matched by its V4L2 format), as rpi/gst-plugins-base's
# NV12_128C8 and NV12_10LE32_128C8, and the column strides in Wayland's
# dmabuf protocol. prepare() applies them from the packaging of the
# gst-plugins-bad Raspberry Pi OS ships (_rpi_debian, in
# https://archive.raspberrypi.com/debian/pool/main/g/gst-plugins-bad1.0/);
# its other v4l2codecs patches (copy_frames, has_videometa, the HEVC
# cropping) are in 1.28 already. It builds with, and needs,
# rpi/gst-plugins-base, which build-alpine-gnome-iso.sh builds first.
# pkgver is Alpine's, plus _p and the +rpt release, so it ranks above
# Alpine's. Update it to Alpine's APKBUILD for the same _alpine with
# Raspberry Pi OS's patches for that version; build-alpine-gnome-iso.sh
# stops when Alpine's gst-plugins-bad is no longer _alpine.
_alpine=1.28.3-r0
_rpi_debian=gst-plugins-bad1.0_1.26.2-3+rpt4+deb13u3.debian.tar.xz
_rpi_patches="
	0001-v4l2codecs-update-bit-size
	0002-v4l2codecs-Match-V4L2_PIX_FMT_NC12
	0003-v4l2codecs-Update-videodev2_h
	0004-v4l2codecs-Add-GST_VIDEO_FORMAT_NV12_128C8
	0005-v4l2codecs-Add-support-for-GST_VIDEO_FORMAT_NV12_10L32_128C8
	wayland_dmabuf
	"
pkgname=gst-plugins-bad
pkgver=1.28.3_p4
_pkgver=${pkgver%_p*}
pkgrel=0
# NOTE: Upgrade together with the whole GStreamer suite &
# only to even-numbered versions (e.g. 1.18.x, 1.20.x)!
pkgdesc="GStreamer streaming media framework bad plug-ins"
url="https://gstreamer.freedesktop.org/"
arch="aarch64"
license="GPL-2.0-or-later LGPL-2.0-or-later"
replaces="gst-plugins-bad1"
depends="gst-plugins-base>=1.28.3_p3"
# chromaprint causes a circular dependency:
# pipewire -> libcamera -> here -> chromaprint -> ffmpeg -> sdl2 -> pipewire
makedepends="
	alsa-lib-dev
	aom-dev
	bluez-dev
	bzip2-dev
	curl-dev
	directfb-dev
	faac-dev
	faad2-dev
	fdk-aac-dev
	flite-dev
	glib-dev
	glu-dev
	gobject-introspection-dev
	gsm-dev
	gst-plugins-base-dev>=1.28.3_p3
	gstreamer-dev
	gtk+3.0-dev
	lcms2-dev
	libass-dev
	libdc1394-dev
	libde265-dev
	libdvdnav-dev
	libdvdread-dev
	libexif-dev
	libfreeaptx-dev
	libgudev-dev
	libmms-dev
	libmodplug-dev
	libnice-dev
	librsvg-dev
	libsndfile-dev
	libsrt-dev
	libsrtp-dev
	libusrsctp-dev
	libva-glx-dev
	libvdpau-dev
	libwebp-dev
	libx11-dev
	libxkbcommon-dev
	mesa-dev
	meson
	neon-dev
	openal-soft-dev
	openexr-dev
	openh264-dev
	openjpeg-dev
	openssl-dev>3
	opus-dev
	orc-dev
	pango-dev
	rtmpdump-dev
	sbc-dev
	soundtouch-dev
	spandsp-dev
	tiff-dev
	vo-aacenc-dev
	vo-amrwbenc-dev
	vulkan-headers
	vulkan-loader-dev
	wayland-dev
	wayland-protocols
	x265-dev
	zbar-dev
	"
subpackages="$pkgname-dbg $pkgname-lang $pkgname-dev"
source="
	https://gstreamer.freedesktop.org/src/gst-plugins-bad/gst-plugins-bad-$_pkgver.tar.xz
	0001-jifmux-Make-copies-of-parsed-image-buffer-parts.patch
	test-skip.patch
	https://archive.raspberrypi.com/debian/pool/main/g/gst-plugins-bad1.0/$_rpi_debian
	"
builddir="$srcdir/gst-plugins-bad-$_pkgver"
ldpath="/usr/lib/gstreamer-1.0"

case "$CARCH" in
s390x)
	;;
*)
	makedepends="$makedepends libldac-dev"
	;;
esac

case "$CARCH" in
x86|armhf|armv7)
	;;
*)
	makedepends="$makedepends svt-av1-dev"
	;;
esac

# secfixes:
#   1.26.3-r0:
#     - CVE-2025-6663
#   1.26.1-r0:
#     - CVE-2025-3887
#   1.22.9-r0:
#     - CVE-2024-0444
#   1.22.8-r0:
#     - ZDI-CAN-22300
#   1.22.7-r0:
#     - CVE-2023-44446
#     - CVE-2023-44429
#   1.22.6-r0:
#     - CVE-2023-40476
#     - CVE-2023-40475
#     - CVE-2023-40474
#   1.22.4-r0:
#     - CVE-2023-37329
#     - CVE-2023-37328

prepare() {
	default_prepare
	local p
	for p in $_rpi_patches; do
		patch -p1 -i "$srcdir"/debian/patches/$p.patch
	done
}

build() {
	CFLAGS="$CFLAGS -O2" \
	CXXFLAGS="$CXXFLAGS -O2" \
	CPPFLAGS="$CPPFLAGS -O2" \
	abuild-meson \
		-Db_lto=true \
		-Dpackage-origin="https://alpinelinux.org" \
		-Dpackage-name="GStreamer bad plug-ins (Alpine Linux)" \
		-Dintrospection=enabled \
		-Dgpl=enabled \
		-Dsctp=enabled \
		-Dsrt=enabled \
		-Dva=enabled \
		-Dtests="$(want_check && echo enabled || echo disabled)" \
		. output
	meson compile -C output
}

check() {
	XDG_RUNTIME_DIR="$(mktemp -d)" \
		meson test -C output --print-errorlogs
}

package() {
	DESTDIR="$pkgdir" meson install --no-rebuild -C output
}

