# Contributor: Sören Tempel <soeren+alpine@soeren-tempel.net>
#
# Alpine's main/wpa_supplicant (_alpine below) with Raspberry Pi OS's
# patches for WPA3 with the Pi's Wi-Fi (from its wpa package, _rpi_debian
# in https://archive.raspberrypi.com/debian/pool/main/w/wpa/), which go
# with the brcmfmac options in cervino-desktop: those leave WPA3's SAE
# handshake to wpa_supplicant rather than the chip's firmware.
# 0020-dbus-Fix-reporting-of-the-SAE-KeyMgmt.patch (from hostap after 2.11,
# as is) reports SAE over D-Bus where the driver lists it as a feature, as
# brcmfmac does, so NetworkManager uses WPA3 there.
# 0021-wpa_supplicant-Don-t-prefer-SAE-over-PSK-without-a-.patch (Raspberry
# Pi's, ported to 2.11) falls back to WPA2 on a WPA2/WPA3 network for which
# only a raw PSK is stored, which SAE can't use. pkgver is Alpine's, plus _p
# and Raspberry Pi OS's +rpt release, so it ranks above Alpine's.
# build-alpine-gnome-iso.sh stops when Alpine's wpa_supplicant is no longer
# _alpine.
_alpine=2.11-r4
_rpi_debian=wpa_2.10-24+rpt3.debian.tar.xz
pkgname=wpa_supplicant
pkgver=2.11_p3
_pkgver=${pkgver%_p*}
pkgrel=0
pkgdesc="utility providing key negotiation for WPA wireless networks"
url="https://w1.fi/wpa_supplicant/"
arch="aarch64"
options="!check" # has no tests
license="BSD-3-Clause"
subpackages="$pkgname-doc $pkgname-openrc $pkgname-systemd"
makedepends="linux-headers openssl-dev>3 dbus-dev libnl3-dev pcsc-lite-dev"
provides="nm-wifi-backend"
provider_priority=10 # highest
source="https://w1.fi/releases/wpa_supplicant-$_pkgver.tar.gz
	wpa_supplicant.initd
	wpa_supplicant.confd
	wpa_cli.confd
	wpa_cli.initd

	0001-nl80211-add-extra-ies-only-if-allowed-by-driver.patch
	0002-AP-guard-FT-SAE-code-with-CONFIG_IEEE80211R_AP.patch
	wpa_supplicant-2.11-Revert-Mark-authorization-completed-on-driver-indica.patch
	0020-dbus-Fix-reporting-of-the-SAE-KeyMgmt.patch
	0021-wpa_supplicant-Don-t-prefer-SAE-over-PSK-without-a-.patch

	config
	wpa_cli.sh
	"

# secfixes:
#   2.10-r11:
#     - CVE-2023-52160
#   2.9-r13:
#     - CVE-2021-30004
#   2.9-r12:
#     - CVE-2021-27803
#   2.9-r10:
#     - CVE-2021-0326
#   2.9-r5:
#     - CVE-2019-16275
#   2.7-r3:
#     - CVE-2019-11555
#   2.7-r2:
#     - CVE-2019-9494
#     - CVE-2019-9495
#     - CVE-2019-9497
#     - CVE-2019-9498
#     - CVE-2019-9499
#   2.6-r14:
#     - CVE-2018-14526
#   2.6-r7:
#     - CVE-2017-13077
#     - CVE-2017-13078
#     - CVE-2017-13079
#     - CVE-2017-13080
#     - CVE-2017-13081
#     - CVE-2017-13082
#     - CVE-2017-13086
#     - CVE-2017-13087
#     - CVE-2017-13088

builddir="$srcdir/wpa_supplicant-$_pkgver"

prepare() {
	default_prepare

	# Copy our configuration file to the build directory
	cp "$srcdir"/config "$builddir"/wpa_supplicant/.config
}

build() {
	export CFLAGS="$CFLAGS -flto=auto"
	cd "$builddir"/wpa_supplicant
	make LIBDIR=/lib BINDIR=/sbin
	make LIBDIR=/lib BINDIR=/sbin eapol_test
}

package() {
	cd "$builddir"/wpa_supplicant
	make DESTDIR="$pkgdir" LIBDIR=/lib BINDIR=/sbin install
	install -Dm644 wpa_supplicant.conf \
		"$pkgdir"/usr/share/doc/wpa_supplicant/examples/wpa_supplicant.conf
	install -Dm755 "$srcdir"/wpa_cli.sh \
		"$pkgdir"/etc/wpa_supplicant/wpa_cli.sh

	local man=
	for man in doc/docbook/*.?; do
		install -Dm644 "$man" \
			"$pkgdir"/usr/share/man/man${man##*.}/${man##*/}
	done
	install -Dm755 eapol_test "$pkgdir"/sbin/eapol_test

	# dbus
	install -Dm644 dbus/dbus-wpa_supplicant.conf \
		"$pkgdir"/usr/share/dbus-1/system.d/wpa_supplicant.conf
	install -Dm644 dbus/fi.w1.wpa_supplicant1.service \
		-t "$pkgdir"/usr/share/dbus-1/system-services

	# openrc runscripts
	install -Dm755 "$srcdir"/wpa_supplicant.initd \
		"$pkgdir"/etc/init.d/wpa_supplicant
	install -Dm644 "$srcdir"/wpa_supplicant.confd \
		"$pkgdir"/etc/conf.d/wpa_supplicant
	install -Dm755 "$srcdir"/wpa_cli.initd \
		"$pkgdir"/etc/init.d/wpa_cli
	install -Dm644 "$srcdir"/wpa_cli.confd \
		"$pkgdir"/etc/conf.d/wpa_cli

	# systemd services
	install -Dm644 systemd/*.service \
		-t "$pkgdir"/usr/lib/systemd/system/
}

