# Cervino's GStreamer playback, as a package of its own beside
# cervino-desktop, so that deleting it (through the apk wrapper) brings
# back Alpine's packages. It is Showtime with our patch
# (patched/showtime), and on the Pi Raspberry Pi OS's builds of
# GStreamer's base and bad plug-ins (rpi/gst-plugins-base and
# rpi/gst-plugins-bad), for the Pi's HEVC decoder in GStreamer, in place
# of Alpine's (see build_bundle in build-alpine-gnome-iso.sh, which puts
# their runtime packages in apks/ next to this, with
# cervino-gstreamer.conf).
# The bad plug-ins' decoder uses the video formats the base ones add, so
# the two go together. Showtime works with either's plug-ins.
# abuild sets startdir and pkgdir and reads the variables set here.
# shellcheck shell=sh disable=SC2034,SC2153,SC2154
. "$startdir"/cervino-gstreamer.conf

pkgname=cervino-gstreamer
pkgver=$PKGVER
pkgrel=0
pkgdesc="GStreamer plug-ins of the Cervino GNOME desktop"
url="https://github.com/MartinRixham/cervino"
arch="noarch"
license="$LICENSE"
provides="$PROVIDES"
depends="$DEPENDS"
# The packages' files are stripped already, their debug symbols in their
# -dbg packages; what they provide and depend on is in the .conf.
options="!check !strip !tracedeps"

# Showtime is noarch; the Pi's plug-ins are not.
[ "$TARGET_ARCH" = aarch64 ] && arch="aarch64"

package() {
	mkdir -p "$pkgdir"
	local apk
	for apk in "$startdir"/apks/*.apk; do
		[ -e "$apk" ] || continue
		tar -xzf "$apk" -C "$pkgdir" --warning=no-unknown-keyword --anchored \
			--exclude='.PKGINFO' --exclude='.SIGN.*' --exclude='.pre-*' \
			--exclude='.post-*' --exclude='.trigger'
	done
}
