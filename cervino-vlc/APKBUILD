# VLC, with the FFmpeg it plays through, as a package of its own beside
# cervino-desktop. On the Pi it holds Raspberry Pi OS's builds of ffmpeg7
# and vlc (rpi/), for the Pi's hardware video decoders, in place of
# Alpine's (see build_bundle in build-alpine-gnome-iso.sh, which puts
# their runtime packages in apks/ next to this, with cervino-vlc.conf and
# VLC's plug-in cache scripts). Once it is deleted (through the apk
# wrapper), VLC is gone and what else uses ffmpeg7 gets Alpine's.
# Elsewhere it only depends on Alpine's VLC (vlc-qt), so the PC's image has
# VLC too, gone once this is deleted.
# VLC builds against ffmpeg7's patches, so the two go together; it uses
# GStreamer's libraries too, but cervino-gstreamer's only add to Alpine's.
# abuild sets startdir and pkgdir and reads the variables set here.
# shellcheck shell=sh disable=SC2034,SC2153,SC2154
. "$startdir"/cervino-vlc.conf

pkgname=cervino-vlc
pkgver=$PKGVER
pkgrel=0
pkgdesc="VLC of the Cervino GNOME desktop, with the FFmpeg it plays through"
url="https://github.com/MartinRixham/cervino"
arch="noarch"
license="Apache-2.0"
# The packages' files are stripped already, their debug symbols in their
# -dbg packages; what they provide and depend on is in the .conf.
options="!check !strip !tracedeps"

if [ "$TARGET_ARCH" = aarch64 ]; then
	arch="aarch64"
	license="$LICENSE"
	provides="$PROVIDES"
	depends="$DEPENDS"
	# vlc-libs': VLC's plug-in cache, made when the plug-ins change.
	install="$pkgname.pre-deinstall"
	triggers="$pkgname.trigger=/usr/lib/vlc/plugins"
else
	depends="vlc-qt"
fi

package() {
	mkdir -p "$pkgdir"
	local apk
	for apk in "$startdir"/apks/*.apk; do
		[ -e "$apk" ] || continue
		tar -xzf "$apk" -C "$pkgdir" --warning=no-unknown-keyword --anchored \
			--exclude='.PKGINFO' --exclude='.SIGN.*' --exclude='.pre-*' \
			--exclude='.post-*' --exclude='.trigger'
	done
}
