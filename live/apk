#!/bin/sh
[ -n "$CERVINO_COPY_ROOT" ] && [ "$1" = add ] || exec /usr/sbin/apk "$@"

root= initdb= overlay= prev=
for a; do
	[ "$prev" != --root ] || root=$a
	case $a in --initdb) initdb=1 ;; --overlay-from-stdin) overlay=1 ;; esac
	prev=$a
done
[ -n "$root" ] && [ -n "$initdb" ] && [ -n "$overlay" ] && [ -d /.cervino/ro/etc ] ||
	exec /usr/sbin/apk "$@"

echo "Copying the system to $root..."
# mkinitfs's /boot/boot -> . link can't be made on a FAT /boot (the Pi's);
# like mkinitfs's trigger, make it where it can be.
rsync -aHX --ignore-existing --exclude=/boot/boot /.cervino/ro/ "$root"/ || exit
ln -sf . "$root"/boot/boot 2>/dev/null
for k in "$root"/lib/modules/*; do
	k=${k##*/}
	mkinitfs -b "$root"/ -c "$root"/etc/mkinitfs/mkinitfs.conf \
		-o "$root"/boot/initramfs-"${k##*-}" "$k" ||
		exit
done

first=1
for a; do
	[ -z "$first" ] || { set --; first=; }
	[ "$a" = --initdb ] || set -- "$@" "$a"
done
/usr/sbin/apk "$@" || exit

# The SPICE guest agent only in a VM (see the setup-disk shim).
if [ -z "$CERVINO_VM" ]; then
	/usr/sbin/apk del --root "$root" --quiet spice-vdagent spice-vdagent-openrc ||
		echo "The SPICE guest agent could not be removed." >&2
	rm -f "$root"/etc/runlevels/default/spice-vdagentd
fi

# Firefox's Widevine where Firefox cannot download it (the Pi): see
# cervino-desktop's widevine. Its weekly job tries again, first soon after
# the system starts.
if [ -x /usr/libexec/cervino/widevine ]; then
	echo "Downloading Widevine, for DRM video in Firefox..."
	/usr/libexec/cervino/widevine "$root" ||
		echo "Widevine could not be downloaded:" \
			"the installed system tries again after it starts." >&2
fi

if [ -f "$root"/etc/update-extlinux.conf ] && [ -x "$root"/sbin/update-extlinux ]; then
	chroot "$root" update-extlinux --warn-only || exit
fi
if [ -f "$root"/etc/default/grub ] && [ -x "$root"/usr/sbin/grub-mkconfig ]; then
	chroot "$root" grub-mkconfig -o /boot/grub/grub.cfg || exit
fi
