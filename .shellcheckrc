# The scripts' own idioms, which shellcheck takes for mistakes:
# a= b= sets several variables empty (SC1007); local is in busybox ash
# (SC3043); cmd && ok || die is meant as it reads (SC2015); functions are
# called by name, as run_test's tests are (SC2329).
disable=SC1007,SC3043,SC2015,SC2329
# Sourced files that exist only on the built system or are generated by
# the build (gnomelive.conf, abuild.conf, libalpine.sh) are not followed.
disable=SC1091
# Follow the sources named with a source= directive, relative to the script.
external-sources=true
source-path=SCRIPTDIR
# Programs in single quotes (awk, sed, gjs, sh -c) have their own $ (SC2016).
disable=SC2016
# ls lists names the scripts make (version ids, package files), sorted as
# ls sorts them (SC2010, SC2012, SC2045).
disable=SC2010,SC2012,SC2045
